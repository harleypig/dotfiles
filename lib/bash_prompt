# shellcheck shell=bash
# shellcheck disable=SC2154  # prompt color vars are assigned by the config/shell-startup/bash_prompt wrapper that sources this file

# Ideas ripped off and made to fit from:
#   http://wiki.archlinux.org/index.php/Color_Bash_Prompt
#   http://www.termsys.demon.co.uk/vtansi.htm
#   https://gist.github.com/621452
#   https://gist.github.com/623142

#----------------------------------------------------------------------------
# Only setup the prompt if we are in an interactive session

[[ $- == *i* ]] || {
  debug "Not in interactive mode."
  return 0
}

#----------------------------------------------------------------------------
# All prompt colors are computed once by the config/shell-startup/bash_prompt
# wrapper (atsign_color, color_off, hostname_color, nonroot_color,
# prompt_color, root_color, plus the exit_*/venv_* colors used below), so the
# per-render functions never spawn ansi.

# Array of Unicode characters to rotate through for non-root prompt
# Use show-unicode to see what symbols are available on your current terminal.
PROMPT_CHARS=("$" "●" "★" "➤" "❯" "❔" "⚡" "✸" "♠" "♦" "✱" "⚓" "⛳" "☿" ">"
  "⇨" "✷" "⚫" "→" "✶" "♣" "❓" "❱")

#----------------------------------------------------------------------------
# The _parent function is called once during the .bash_prompt startup to
# determine the parent processes for the current shell session. The result is
# stored in the 'parent_output' variable and used in every prompt update. This
# implementation is based on the understanding that the pstree value doesn't
# change during a single shell session.

function _parent() {

  # _HAS_PSTREE is set once at load time by the config/shell-startup/bash_prompt
  # wrapper (havecmd is unset by the time the prompt renders).
  [[ -z $_HAS_PSTREE ]] && return 0

  local parents

  parents=$(pstree -A $PPID 2> /dev/null) || return 1

  parents=${parents/%-+*/}
  parents=${parents//---bash/}
  parents=${parents//---pstree/}
  parents=${parents//: server/}
  parents=${parents//gnome-terminal-/}
  parents=${parents//login/}
  parents=${parents//node/}
  parents=${parents//poetry/}
  parents=${parents//sshd/}
  parents=${parents//su/}
  parents=${parents//tilix/}
  parents=${parents//tmux/}
  parents=${parents//Relay\([0-9][0-9]*\)/}

  [[ -n $parents ]] \
    && printf '\[%s\](%s)\[%s\] ' \
      "$(ansi -n fg bright_yellow bg red)" "$parents" "$(ansi -n off)"
}

# 'parent' will only ever change upon a new shell, so set it here
parent=$(_parent)

#----------------------------------------------------------------------------
function _exit_status() {
  local status

  for s in "$@"; do

    # Wrap the exit symbols in appropriate ansi codes.

    # If a command is still writing to the pipe and a later command exits, the
    # first command will exit with a status of 141.  This causes confusion
    # with commands like echo or head.

    # Doing this *will* cause confusion if something does exit abnormally but
    # doesn't throw an appropriate exit status.

    case "$s" in
      0 | 141) status+="$exit_good_color $s $color_off" ;;
      *) status+="$exit_bad_color $s $color_off" ;;
    esac
  done

  printf '%s' "$status"
}

#----------------------------------------------------------------------------
# This needs work for poetry setups

_venv() {
  [[ -z $VIRTUAL_ENV ]] && [[ -z $POETRY_ACTIVE ]] && return 0

  local color curpwd dir

  curpwd="$(readlink -ne "$PWD")"

  if [[ -n $POETRY_ACTIVE ]]; then
    # ICEBOX: can't detect the true project directory for a poetry venv
    #         (poetry venvs live outside the project tree). Look into
    #         `poetry config virtualenvs.in-project true` so the venv path
    #         reveals its project. Deferred. Revisit on request.
    color=$venv_poetry_color
    dir="poetry venv"

  else
    # NOTE: a venv activated manually (outside its in-project layout) won't
    #       match $PWD against $VIRTUAL_ENV, so it falls through to the "bad"
    #       color below even when valid — a known limit of this heuristic.
    color=$venv_ok_color
    dir="venv"

    if [[ ! $curpwd =~ ^${VIRTUAL_ENV%/*} ]]; then
      color=$venv_bad_color
      dir="venv: ${VIRTUAL_ENV%/*}"
    fi
  fi

  printf '%s(%s)%s ' "$color" "$dir" "$color_off"
}

#----------------------------------------------------------------------------
# Get a random character from the array
_get_next_prompt_char() {
  local random_index=$((RANDOM % ${#PROMPT_CHARS[@]}))
  echo "${PROMPT_CHARS[$random_index]}"
}

#----------------------------------------------------------------------------
# Runs first in PROMPT_COMMAND, before anything a later-loaded tool module
# (mise, ...) adds -- those may run arbitrary commands of their own, which
# would otherwise overwrite PIPESTATUS before _update_prompt gets to read it.
_capture_exit_status() {
  _prompt_pipestatus=("${PIPESTATUS[@]}")
}

#----------------------------------------------------------------------------
# True (exit 0) when this bash build supports PROMPT_COMMAND as an array
# (5.1+), the only form _bash_prompt_reorder_hooks can compose against. A
# tool module on a pre-5.1 bash should skip hooking PROMPT_COMMAND rather
# than call that function.
_bash_prompt_supports_hooks() {
  ((BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 1)))
}

#----------------------------------------------------------------------------
# Re-pins _capture_exit_status/_update_prompt to the front of PROMPT_COMMAND
# and drops any other entry that isn't a real function. A tool's own
# activation script (mise, ...) always prepends its hook wherever
# PROMPT_COMMAND currently stands, so anything it adds needs to be moved
# back behind these two; a dropped entry means that tool's own guard left a
# dead reference, which would otherwise fail on every prompt. Assumes every
# legitimate entry is a bare function name (true of every tool activation
# script seen so far); a raw command-line entry would be dropped too.
_bash_prompt_reorder_hooks() {
  local -a kept=()
  local entry

  for entry in "${PROMPT_COMMAND[@]}"; do
    [[ $entry == _capture_exit_status || $entry == _update_prompt ]] && continue
    declare -F "$entry" > /dev/null && kept+=("$entry")
  done

  PROMPT_COMMAND=(_capture_exit_status _update_prompt "${kept[@]}")
}

#----------------------------------------------------------------------------
_update_prompt() {
  exit_status=$(_exit_status "${_prompt_pipestatus[@]}")
  unset _prompt_pipestatus

  # Append the last command, clear the history cache and reread the history
  # file
  history -a
  history -c
  history -r

  local finalchr loadavg

  if [[ $UID -eq 0 ]]; then
    user_color="$root_color"
    finalchr='!!'

  else
    user_color="$nonroot_color"
    finalchr="$(_get_next_prompt_char)"
  fi

  # Build the prompt.
  local finalchr loadavg

  PS1="\n$color_off$prompt_color"

  # _HAS_PACMAN_STATUS is cached at load time by the wrapper (see _parent).
  [[ -n $_HAS_PACMAN_STATUS ]] \
    && PS1+="$(pacman-status)"

  # loadavg is bin/loadavg — always present in this setup; if it is missing
  # something is badly broken and should be fixed, so do not guard it.
  loadavg="$(loadavg)"
  [[ -n $loadavg ]] && PS1+="$loadavg\n"

  # For tmux status line
  #PS1+='\[\e]0;\u@\H\a\]'
  PS1+="$parent$user_color\u$atsign_color@$hostname_color\H: "

  # We're assuming dir-readable and git-status are on the system; we want to
  # be notified in a glaring way if they're not.
  PS1+="$(_venv)$(dir-readable)$(git-status)\n"
  PS1+="$exit_status $finalchr "

  unset exit_status
}

if _bash_prompt_supports_hooks; then
  [[ -n $PS1 ]] && PROMPT_COMMAND=(_capture_exit_status _update_prompt)
else
  # shellcheck disable=SC2178  # deliberate: pre-5.1 bash can't hold
  # PROMPT_COMMAND as an array, so this branch intentionally uses the
  # legacy string form instead of the array form used above.
  [[ -n $PS1 ]] && PROMPT_COMMAND='_capture_exit_status;_update_prompt'
fi
