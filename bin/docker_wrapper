#!/usr/bin/env bash

# Multi-call dispatcher for dockerized CLI tools and the local AI/LLM
# daemons. It is invoked through a symlink named for the tool; the
# basename of $0 selects which function to run. For example
#   bin/shellcheck -> docker_wrapper
# runs the shellcheck() function, which execs the shellcheck image.
#
# Forwarding host env vars:
#   Leading `-e NAME` / `--env NAME` flags (repeatable) name host environment
#   variables to forward into the container, e.g.
#     bin/terraform -e MXROUTE_API_KEY -e MXROUTE_SERVER plan
#   Each becomes a `docker run --env NAME` (forwarded by name — the value is
#   read from the host env, never placed on the command line). This lets a
#   caller pass whatever a run needs without editing per-tool forwarding here.
#   The flags must lead (parsing stops at the first non-flag argument), and
#   apply to every $PWD-mounted tool except those whose own CLI claims -e
#   (shellcheck, whose -e is --exclude — see native_e_tools below); the daemons
#   do not take them.
#
# Add a tool:
#   1. write a <tool>() function below (build args, exec docker run)
#   2. register its image next to the function:
#      image[<tool>]='<repo>/<image>:<tag>' — the image[] keys ARE the
#      dispatchable-tool registry, so this one line registers the tool.
#   3. create the bin/<tool> symlink — `docker_wrapper-links --fix` creates
#      it for every registered-but-unlinked tool, or by hand:
#      ln -s docker_wrapper bin/<tool>
#
# Introspection (only when run by the real name, not a tool symlink):
#   docker_wrapper --known-tools   list registered tool names
#   docker_wrapper --images        list each tool and its docker image
# bin/docker_wrapper-links checks/repairs the bin/<tool> symlinks against
# --known-tools.
#
# Families (how each function is shaped):
#   pwd-mounted linters  shellcheck shfmt yamllint prettier hadolint
#                        markdownlint
#   scanners             trivy (pwd + socket)  dive (socket only)
#   daemons              ollama openwebui (host-gated, detached)
#
# IMAGE PINNING: trivy/hadolint/dive are pinned by digest per
# rules/docker.md (trivy was supply-chain compromised twice in 03/2026 —
# pin + run the image directly, never the marketplace actions). The
# linter images still use rolling tags; pinning them is queued in TODO.md.
# Each tool's image lives in the image[] array beside its function. Bump a
# tag + digest together with:
#   docker buildx imagetools inspect <image>:<tag>

set -uo pipefail

# Resolve our real path through the invoking symlink to locate lib/.
self=$(readlink -f "${BASH_SOURCE[0]}")
libdir=$(dirname "$self")/../lib

# shellcheck source=/dev/null
source "$libdir/docker_helpers"

tool=${0##*/}
export DW_TAG="${tool}: "

# Registry of dispatchable tools, keyed by tool name -> its docker image.
# Each function registers its image immediately after its definition, so a
# tool is dispatchable iff it has an image entry; removing a tool is one
# local edit (the function, its image[] line, and the symlink) with no
# dangling reference left in the dispatcher below. `--known-tools` and
# `--images` print this registry.
declare -A image=()

###############################################################################
# Tool functions. Each is invoked as `"$tool" "$@"`, so the function name
# shadows the host binary of the same name — exactly what we want.

#------------------------------------------------------------------------------
shellcheck() {
  dw_guard_pwd_paths shellcheck "$@" || exit 1

  local -a args=(--rm)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  # Forward SHELLCHECK_OPTS if set; the tool honours it in-container.
  [[ -n ${SHELLCHECK_OPTS-} ]] && args+=(--env "SHELLCHECK_OPTS=$SHELLCHECK_OPTS")

  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/shellcheckrc"
  if [[ -f $cfg ]]; then
    dw_set_home args /home/shellcheck
    dw_mount args "$cfg" /home/shellcheck/.shellcheckrc ro
  fi

  exec docker run "${args[@]}" "${image[shellcheck]}" "$@"
}
image[shellcheck]="koalaman/shellcheck:stable"

#------------------------------------------------------------------------------
shfmt() {
  dw_guard_pwd_paths shfmt "$@" || exit 1

  local -a args=(--rm)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  # Forward stdin when it is piped (not a TTY), so `shfmt ... < file` reaches
  # the container instead of an empty stream. bin/showvars relies on this with
  # `shfmt -tojson < script`; without -i the AST comes back empty.
  [[ -t 0 ]] || args+=(-i)

  exec docker run "${args[@]}" "${image[shfmt]}" "$@"
}
image[shfmt]="mvdan/shfmt:v3"

#------------------------------------------------------------------------------
yamllint() {
  dw_guard_pwd_paths yamllint "$@" || exit 1

  local -a args=(--rm)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  # Mount XDG config so yamllint finds /config/yamllint/config inside.
  local xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
  if [[ -d $xdg/yamllint ]]; then
    dw_mount args "$xdg" /config ro
    args+=(--env "XDG_CONFIG_HOME=/config")
  fi

  exec docker run "${args[@]}" "${image[yamllint]}" "$@"
}
image[yamllint]="cytopia/yamllint:latest"

#------------------------------------------------------------------------------
# IaC tools (terraform / packer / tflint). Subcommand-driven, so they skip
# dw_guard_pwd_paths (args are subcommands/flags, not just file paths) — the
# caller passes pwd-relative targets. dw_user makes files that `terraform fmt` /
# `packer fmt` rewrite land host-owned, not root; HOME=/tmp gives a writable
# home under --user for any plugin/cache path.
terraform() {
  local -a args=(--rm --env HOME=/tmp)
  # Keep stdin open for piped input (`terraform fmt -`); add a TTY when
  # attached to a terminal so interactive prompts (apply, console) work.
  args+=(-i)
  [[ -t 0 && -t 1 ]] && args+=(-t)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  # Forward a caller-supplied CLI config file (provider_installation, credential
  # helpers, etc.) when set. Forwarded by name so the value comes from the host
  # env; the value must be a path INSIDE the mount (/mnt/...), since only $PWD
  # is mounted. A repo uses this to point terraform at, e.g., a credential
  # helper, or a provider_installation filesystem_mirror / network_mirror for
  # an internally hosted provider. Set for every subcommand: validate/plan
  # need the provider schema, not just init.
  [[ -n ${TF_CLI_CONFIG_FILE-} ]] && args+=(--env TF_CLI_CONFIG_FILE)

  # Resolve the subcommand: the first non-flag word, since global options
  # (`-chdir=DIR`, `-help`, `-version`) precede it.
  local subcmd="" arg
  for arg in "$@"; do
    [[ $arg == -* ]] && continue
    subcmd=$arg
    break
  done

  # Forward cloud credentials ONLY for subcommands that reach the state
  # backend or configure providers (init/plan/apply and kin), so the S3
  # state backend (Linode Object Storage) and the Linode provider can
  # authenticate. fmt/validate/version stay credential-free — rules/
  # terraform.md runs validate with dummy AWS creds on purpose, so real
  # secrets must never leak into them. Fail closed: an unrecognized
  # subcommand gets nothing. Each var is forwarded by name (docker reads
  # the value from the host env), so secrets never appear on the command
  # line or in the process list. The checksum vars suppress the new AWS
  # SDK request/response checksums that Linode Object Storage rejects.
  case $subcmd in
    init | plan | apply | destroy | refresh | import | console | output | state | taint | untaint | force-unlock | workspace | show)
      # ICEBOX: the Linode provider's config_profile / linode-cli config-file
      # auth path is not mounted — LINODE_TOKEN covers the credential need, so
      # mounting ~/.config/linode under HOME=/tmp was deliberately skipped.
      local var
      for var in \
        AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_ENDPOINT_URL_S3 \
        AWS_REQUEST_CHECKSUM_CALCULATION AWS_RESPONSE_CHECKSUM_VALIDATION \
        LINODE_TOKEN; do
        [[ -n ${!var-} ]] && args+=(--env "$var")
      done
      ;;
  esac

  exec docker run "${args[@]}" "${image[terraform]}" "$@"
}
image[terraform]="hashicorp/terraform:1.15"

#------------------------------------------------------------------------------
packer() {
  local -a args=(--rm --env HOME=/tmp)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  exec docker run "${args[@]}" "${image[packer]}" "$@"
}
image[packer]="hashicorp/packer:1.15"

#------------------------------------------------------------------------------
tflint() {
  local -a args=(--rm --env HOME=/tmp)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  exec docker run "${args[@]}" "${image[tflint]}" "$@"
}
image[tflint]="ghcr.io/terraform-linters/tflint:v0.63.1"

#------------------------------------------------------------------------------
# terraform-docs generates/injects module READMEs from .tf sources (static
# parse — no init, no credentials). Subcommand/flag-driven like the other IaC
# tools, so it skips dw_guard_pwd_paths; dw_user keeps the injected README
# host-owned, HOME=/tmp gives a writable home under --user.
terraform-docs() {
  local -a args=(--rm --env HOME=/tmp)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  # Quote the literal key: shfmt would otherwise read the `-` in the
  # associative-array subscript as arithmetic and mangle it (terraform - docs).
  exec docker run "${args[@]}" "${image["terraform-docs"]}" "$@"
}
image["terraform-docs"]="quay.io/terraform-docs/terraform-docs:0.20.0"

#------------------------------------------------------------------------------
prettier() {
  dw_guard_pwd_paths prettier "$@" || exit 1

  local -a args=(--rm)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  exec docker run "${args[@]}" "${image[prettier]}" "$@"
}
image[prettier]="prettier:latest"

#------------------------------------------------------------------------------
hadolint() {
  dw_guard_pwd_paths hadolint "$@" || exit 1

  local -a args=(--rm)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  # A repo-local .hadolint.yaml in $PWD wins (hadolint searches cwd
  # first); the global config is the fallback under $HOME/.config.
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/hadolint.yaml"
  if [[ -f $cfg ]]; then
    dw_set_home args /home/hadolint
    dw_mount args "$cfg" /home/hadolint/.config/hadolint.yaml ro
  fi

  # The -alpine image has no ENTRYPOINT (its CMD reads stdin), so name
  # the binary explicitly to pass file arguments through.
  exec docker run "${args[@]}" "${image[hadolint]}" hadolint "$@"
}
image[hadolint]="hadolint/hadolint:v2.14.0-alpine@sha256:7aba693c1442eb31c0b015c129697cb3b6cb7da589d85c7562f9deb435a6657c"

#------------------------------------------------------------------------------
markdownlint() {
  dw_guard_pwd_paths markdownlint "$@" || exit 1

  local -a args=(--rm)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  # The image entrypoint is markdownlint; the repo-local .markdownlint.json
  # is auto-discovered from /mnt (= $PWD).
  exec docker run "${args[@]}" "${image[markdownlint]}" "$@"
}
# SYNC: keep this tag in lock-step with the markdownlint-cli `rev:` in
# .pre-commit-config.yaml and .pre-commit-config-fix.yaml; bump all three
# together so the wrapper CLI and the pre-commit hook stay identical.
image[markdownlint]="ghcr.io/igorshubovych/markdownlint-cli:v0.48.0"

#------------------------------------------------------------------------------
perltidy() {
  dw_guard_pwd_paths perltidy "$@" || exit 1

  local -a args=(--rm)
  dw_user args
  dw_env args "${DW_ENV[@]}"
  dw_mount args "$PWD" /mnt
  args+=(--workdir /mnt)

  # The perl-tools image has no entrypoint (one image can host several tools),
  # so name the tool. The repo-root .perltidyrc (-> config/perl/perltidyrc) is
  # auto-discovered from /mnt (= $PWD), matching how shfmt finds .editorconfig.
  exec docker run "${args[@]}" "${image[perltidy]}" perltidy "$@"
}
# SYNC: keep this tag+digest in lock-step with the perltidy hooks in
# .pre-commit-config.yaml / -fix.yaml, and with the publish-tool-images matrix.
# To bump: change the module version in .github/workflows/publish-tool-images.yml,
# let it publish, then re-pin the tag + digest here (docker pull, then
# `docker inspect --format '{{index .RepoDigests 0}}'`).
image[perltidy]="ghcr.io/harleypig/perltidy:20250912@sha256:61983dd2a1c283df0b839f8fa7a45bcbca5228c7a24495567cbabc3fa997f37b"

#------------------------------------------------------------------------------
