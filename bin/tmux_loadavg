#!/usr/bin/env bash
#
# tmux_loadavg - the system load average, styled for the tmux status line
#
# Usage: tmux_loadavg [loadavg_file]
#
# Called by tmux from status-right as #(tmux_loadavg), once per
# status-interval. Prints the 1, 5 and 15 minute load averages followed by a
# space, each coloured against the CPU count the way motd colours them:
# yellow above one load per CPU, red above two, the status style otherwise.
#
# loadavg_file defaults to /proc/loadavg. Where it cannot be read or does
# not parse (macOS, Windows outside WSL) nothing is printed and the exit
# status is 0, so the status line simply goes without.

set -euo pipefail

if (($# > 1)); then
  echo "Usage: ${0##*/} [loadavg_file]" >&2
  exit 2
fi

self=$(readlink -f "${BASH_SOURCE[0]}") || exit 0

# shellcheck source=/dev/null
source "${self%/*}/../lib/loadavg" 2> /dev/null || exit 0

loads=() levels=()
loadavg_classify loads levels "${1:-}" || exit 0

out=

for i in 0 1 2; do
  case ${levels[i]} in
    alert) out+="#[fg=red]${loads[i]}#[default] " ;;
    warn) out+="#[fg=yellow]${loads[i]}#[default] " ;;
    *) out+="${loads[i]} " ;;
  esac
done

printf '%s' "$out"
