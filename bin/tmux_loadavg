#!/usr/bin/env bash
#
# tmux_loadavg - the system load average, styled for the tmux status line
#
# Usage: tmux_loadavg [loadavg_file]
#
# Called by tmux from status-right as #(tmux_loadavg), once per
# status-interval. Prints the 15 minute load average with bin/loadavg's
# thresholds and colours -- yellow above one load per CPU, yellow on red
# above two -- but always, where loadavg prints only while the machine is
# busy. The value is right-aligned in six columns and followed by one space,
# with the padding outside the colour so a background covers only the
# digits; status-right places it straight after the mode indicator.
#
# loadavg_file defaults to /proc/loadavg. Where it cannot be read or does
# not parse (macOS, Windows outside WSL) nothing is printed and the exit
# status is 0, so the status line simply goes without.

set -euo pipefail

if (($# > 1)); then
  echo "Usage: ${0##*/} [loadavg_file]" >&2
  exit 2
fi

self=$(readlink -f "${BASH_SOURCE[0]}") || exit 0

# shellcheck source=/dev/null
source "${self%/*}/../lib/loadavg" 2> /dev/null || exit 0

loads=() levels=()
loadavg_classify loads levels "${1:-}" || exit 0

pad=$(printf '%6s' "${loads[2]}")
pad=${pad%"${loads[2]}"}

case ${levels[2]} in
  alert) printf '%s#[fg=yellow,bg=red]%s#[default] ' "$pad" "${loads[2]}" ;;
  warn) printf '%s#[fg=yellow]%s#[default] ' "$pad" "${loads[2]}" ;;
  *) printf '%s%s ' "$pad" "${loads[2]}" ;;
esac
