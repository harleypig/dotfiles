#!/bin/bash
#
# git-branch-clean - Delete local branches that no longer exist on remote
#
# Usage: git branch-clean [-n|-f] [-a] [-h]
#
# Options:
#   -n  Dry run - show what would be deleted
#   -f  Force delete branches (required for actual deletion)
#   -a  Include branches never pushed to remote
#   -h  Show this help message
#
# Exactly one of -n / -f must be given: parse_params enforces that with
# `exclusive` + `require-one` constraints (see the global bash.md "Argument
# Parsing"), replacing the old hand-written mutual-exclusion / require checks.

# shellcheck disable=SC2154  # dry_run/force/all are set by the parse_params eval

##############################################################################
# Setup and Sanity
set -euo pipefail

bindir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

##############################################################################
# Functions

#-----------------------------------------------------------------------------
# A branch checked out in any worktree cannot be deleted, so it is reported
# and skipped. A refused deletion is recorded in $failed rather than aborting,
# so one stubborn branch does not stop the rest being cleaned.
remove_branch() {
  local branch="$1"
  local reason="$2"
  local worktree="$3"

  if [[ -z $branch ]]; then
    return 0
  fi

  if [[ -n $worktree ]]; then
    echo "Skipping branch: $branch (checked out in worktree $worktree)"

  elif ((dry_run)); then
    echo "Would delete branch: $branch ($reason)"

  elif ((force)); then
    echo "Deleting branch: $branch"
    git branch -D "$branch" || failed=1
  fi
}

##############################################################################
# Parse options. parse_params supplies -h/--help and enforces "exactly one of
# -n/-f" itself: --auto prints the error + usage and stops on a bad combination
# (none given, or both) or value.
git rev-parse --git-dir &> /dev/null || {
  echo "git-branch-clean: not a git repository" >&2
  exit 1
}

PARM_DEF='
n,boolean,dry_run
f,boolean,force
a,boolean,all
%,exclusive,dry_run,force
%,require-one,dry_run,force
'

eval "$("$bindir/parse_params" --auto --prog "${0##*/}" "$PARM_DEF" "$@")"

##############################################################################
# Fetch and prune to ensure we have current remote information
git fetch --prune

# One pass over the refs: branch_name<tab>reason<tab>worktree_path. The
# worktree field is empty unless the branch is checked out in some worktree
# (this one included). Tab-separated because upstream and worktree can be
# empty, which whitespace splitting would collapse.
readarray -t branches < <(
  git for-each-ref \
    --format '%(refname)%09%(upstream)%09%(upstream:track)%09%(worktreepath)' \
    refs/heads \
    | awk -F'\t' -v all="$all" '
      {
        name = $1
        sub("refs/heads/", "", name)
        if ($3 == "[gone]") {
          print name "\tremote branch gone\t" $4
        } else if (all && $2 == "") {
          print name "\tnever pushed\t" $4
        }
      }'
)

failed=0

for branch_info in "${branches[@]}"; do
  IFS=$'\t' read -r branch reason worktree <<< "$branch_info"
  remove_branch "$branch" "$reason" "$worktree"
done

exit "$failed"
