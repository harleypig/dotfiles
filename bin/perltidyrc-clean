#!/usr/bin/env perl
use strict;
use warnings;
use Getopt::Long qw(:config bundling pass_through);
use Scalar::Util qw(looks_like_number);
use File::Basename;
use Carp qw(croak);
use Cwd;
use File::Spec;

# ------------------------------------------------------------------------------

# Check for Perl::Tidy dependency early
eval { require Perl::Tidy; 1 }
  or die "Perl::Tidy not installed\n";

my $version = $Perl::Tidy::VERSION;
if ( $version < 20060528 ) {
  die "perltidy version $version cannot read options\n";
}

# ------------------------------------------------------------------------------

my @original_argv = @ARGV;
my %cli           = (
  drop_defaults        => 1,
  condense             => 1,
  quiet                => 0,
  keep_defaults        => 0,
  add_missing_defaults => 0,
  outfile              => undef,
  showconfig           => 0,
  overwrite            => 0,
);

my $empty = "";                        # Declared here to remain valid for reference

# ------------------------------------------------------------------------------
# Utility Subroutines
# ------------------------------------------------------------------------------

# Normalizes Perl::Tidy boolean option values to a consistent true/false.
# Handles values that may be strings ("1", "0"), actual booleans, or undefined.
# Returns 1 for positive integers and truthy values, 0 otherwise.
sub is_true {
  my ($value) = @_;
  return 0 unless defined $value;
  return $value =~ /^[1-9]\d*$/x ? 1 : $value ? 1 : 0;
}

# Checks if a value looks like an integer (not a decimal or scientific notation).
# Uses Scalar::Util::looks_like_number to check if it's numeric, then verifies
# it's an integer by checking the string doesn't contain '.' or 'e'/'E', and
# that the numeric value equals its integer conversion.
sub looks_like_integer {
  my ($value) = @_;
  return 0 unless defined $value;
  return 0 unless looks_like_number($value);

  # Reject if string contains decimal point or scientific notation
  my $str = "$value";
  return 0 if $str =~ /[.eE]/x;
  return $value == int($value) ? 1 : 0;
}

# Checks for undefined or empty string keys in a hash reference and dies with a helpful error message.
# This is a developer error - hash keys should never be undefined or empty strings.
# Note: Perl stringifies undef to "" when used as a hash key, so we check for both.
sub check_undefined_keys {
  my ( $hash_ref, $context ) = @_;
  return unless $hash_ref;             # Handle undef hash reference
  $context //= 'hash';
  foreach my $key ( keys %{$hash_ref} ) {
    if ( !defined $key || $key eq '' ) {
      die "Internal error: undefined or empty key found in $context\n";
    }
  }

  return;
}

# Extracts numeric prefix from section name for sorting (e.g., "1.2" from "1.2. Subsection").
# Sections without numeric prefix return 999 to sort them at the end.
sub section_order {
  my ($section) = @_;
  my ($order)   = $section =~ /^(\d+(?:\.\d+)?)/x;
  return $order // 999;
}

# Calls Perl::Tidy::perltidy with parameter validation and error handling.
# Parameters:
#   $params_ref - Reference to hash of parameters to pass to Perl::Tidy::perltidy
#   $context    - String describing the context (for error messages)
#   $stderr_ref - Reference to scalar to capture stderr output
#   $error_mode - 'die' to die on errors, 'accumulate' to return error message
# Returns:
#   In 'die' mode: Returns error code (0, 1, or 2)
#   In 'accumulate' mode: Returns (error_code, error_message)
#                         error_message is appended to if error_code == 1
sub call_perltidy {
  my ( $params_ref, $context, $stderr_ref, $error_mode ) = @_;

  # Validate parameter hash (hashes always have even number of elements)
  croak "Internal error: invalid parameter hash for $context"
    if !$params_ref || ref($params_ref) ne 'HASH' || !keys %{$params_ref};

  # Validate stderr reference
  croak "Internal error: stderr_ref must be a scalar reference for $context"
    if !$stderr_ref || ref($stderr_ref) ne 'SCALAR';

  # Call Perl::Tidy::perltidy
  my $err = Perl::Tidy::perltidy( %{$params_ref} );

  # Handle errors based on mode
  if ( $error_mode eq 'die' ) {
    if ( $err == 1 ) {
      die "Error calling perltidy for $context: $$stderr_ref\n";
    } elsif ( $err == 2 ) {
      warn "Warnings from perltidy $context: $$stderr_ref\n";
    }
    return $err;
  } elsif ( $error_mode eq 'accumulate' ) {

    # Always include stderr in error message (matches original behavior)
    # The caller will append this to their error_message accumulator
    my $error_message = $$stderr_ref;
    if ( $err == 1 ) {

      # Always add error message when there's an error (matches original behavior)
      # The original code had: $error_message ||= ""; followed by unconditional append
      $error_message ||= "";
      $error_message .= "perltidy reported an error while $context\n";
    } elsif ( $err == 2 ) {

      # Warnings are already in stderr, just note them
    }
    return ( $err, $error_message );
  } else {
    die "Internal error: invalid error_mode '$error_mode' for call_perltidy\n";
  }
} ## end sub call_perltidy

sub add_section_note {
  my ( $sections, $section_notes, $opt, $text ) = @_;

  # Handle undefined option or missing/undef section to avoid warnings
  my $section =
    ( defined $opt && exists $sections->{$opt} && defined $sections->{$opt} )
    ? $sections->{$opt}
    : 'UNKNOWN';
  push @{ $section_notes->{$section} }, $text;
  return;
}

# ------------------------------------------------------------------------------
# Main Section Subroutines
# ------------------------------------------------------------------------------

sub usage {
  my ($exit_code) = @_;
  $exit_code = 0 unless defined $exit_code;
  print <<'USAGE';
perltidyrc-clean [--rc FILE | --no-rc] [--keep-defaults] [--[no-]condense]
                 [--quiet] [--showconfig] [--help]

  --rc FILE         Load the specified perltidyrc instead of searching.
  --no-rc           Do not load any perltidyrc (process from empty state).
  --keep-defaults   Keep options which match perltidy defaults (normally
                    removed). Does NOT add missing defaults; use
                    --add-missing-defaults for that.
  --add-missing-defaults
                    Add any missing default options (implies --keep-defaults
                    and --no-condense).
  --[no-]condense   Drop fine-grained options that duplicate broader settings
                    (on by default).
  --outfile FILE, -o FILE
                    Write output to FILE instead of stdout. Recognized even
                    though not used when parsing options.
  --overwrite       Overwrite the --rc file with the cleaned output. Requires
                    --rc to be specified. Mutually exclusive with --outfile.
  --quiet, -q       Omit header comments in the output.
  --showconfig      Print the location of the perltidyrc file as Perl::Tidy
                    sees it and exit. If --rc is specified, reports that file.
                    All other options are ignored (except --help).
  --help, -h        Show this message.

Any additional arguments are passed directly to perltidy; perltidy will report
an error if it does not recognize them.

The output is a cleaned perltidyrc grouped by the Formatting Options sections
from the perltidy manual.

Note: --no-rc explicitly starts from Perl::Tidy defaults and overlays any
explicit options passed through. If no config file is found (and neither --rc
nor --no-rc is specified), the output will be empty unless --add-missing-defaults
is used.
USAGE
  exit $exit_code;
} ## end sub usage

sub set_keep_defaults {
  $cli{drop_defaults} = 0;
  $cli{keep_defaults} = 1;
  return;
}

sub set_add_missing_defaults {
  $cli{add_missing_defaults} = 1;
  $cli{drop_defaults}        = 0;
  $cli{keep_defaults}        = 1;
  $cli{condense}             = 0;      # implies --no-condense
  return;
}

sub extract_outfile {
  my ($args) = @_;
  my $outfile;
  my @filtered;
  while (@$args) {
    my $arg = shift @$args;

    # Combined regex: matches -o, --outfile, -ofilename,
    # --outfile=filename, or --outfilefilename (but we're not going to
    #document that last one)
    if ( $arg =~ /^(?:-o|--outfile=?)(\S*)$/x ) {
      $outfile = $1;

      # If no filename attached, check next arg (if it's not an option)
      if ( !$outfile && @$args && $args->[0] !~ /^-/x ) {
        $outfile = shift @$args;
      } elsif ( !$outfile ) {
        die "Error: --outfile or -o requires a filename\n";
      }
      next;
    }
    push @filtered, $arg;
  } ## end while (@$args)
  @$args = @filtered;
  return $outfile;
} ## end sub extract_outfile

# Find the perltidyrc file that Perl::Tidy would use when no --rc is specified.
# Uses Perl::Tidy's own find_config_file function to ensure we get the exact same
# result that Perl::Tidy would use, including proper handling of PERLTIDY env var
# and system-wide config files.
# Returns the path if found, or undef if not found.
sub find_perltidyrc {

  # Check if Perl::Tidy::find_config_file is available
  unless ( defined &Perl::Tidy::find_config_file ) {
    die "Perl::Tidy::find_config_file is not available\n";
  }

  # Call Perl::Tidy's find_config_file function
  # This script only runs on Linux, so pass 0 for is_Windows and undef for Windows_type
  my $config_file_chatter  = "";
  my $pending_complaint    = "";
  my $rconfig_file_chatter = \$config_file_chatter;
  my $rpending_complaint   = \$pending_complaint;
  my $config_file          = Perl::Tidy::find_config_file(
    0,                                 # is_Windows = false (Linux only)
    undef,                             # Windows_type = undef (not Windows)
    $rconfig_file_chatter,
    $rpending_complaint
  );

  return $config_file;
} ## end sub find_perltidyrc

# The absolute form of a path; an already-absolute path is returned as is.
sub abs_path_of {
  my ($path) = @_;
  return File::Spec->file_name_is_absolute($path)
    ? $path
    : File::Spec->rel2abs($path);
}

# The absolute path of a named config file, dying if it cannot be read.
sub readable_rc {
  my ($rc_file) = @_;
  unless ( -f $rc_file && -r $rc_file ) {
    die "Error: config file '$rc_file' not found or not readable\n";
  }
  return abs_path_of($rc_file);
}

# The first --rc or --no-rc among the pass-through arguments, which Perl::Tidy
# would honour. Returns ('rc', FILE), ('no-rc'), or an empty list for neither.
# A trailing --rc with no value after it is ignored.
sub rc_from_passthrough {
  my ($perltidy_args) = @_;
  foreach my $i ( 0 .. $#{$perltidy_args} ) {
    my $arg = $perltidy_args->[$i];
    if ( $arg =~ /^--rc=(.+)$/x ) {
      return ( 'rc', $1 );
    }
    if ( $arg eq '--rc' && $i + 1 < @{$perltidy_args} ) {
      return ( 'rc', $perltidy_args->[ $i + 1 ] );
    }
    if ( $arg eq '--no-rc' ) {
      return ('no-rc');
    }
  }
  return;
}

# The config file named by the PERLTIDY environment variable, which may be a
# file or a directory holding a .perltidyrc. Returns undef when PERLTIDY is
# unset or names nothing readable, so the caller falls through to a search.
sub rc_from_env {
  my $perltidy_env = $ENV{PERLTIDY};
  return if !defined $perltidy_env;

  if ( -f $perltidy_env && -r $perltidy_env ) {
    return abs_path_of($perltidy_env);
  }

  if ( -d $perltidy_env ) {
    my $rc_in_dir = File::Spec->catfile( $perltidy_env, '.perltidyrc' );
    return abs_path_of($rc_in_dir) if -f $rc_in_dir && -r $rc_in_dir;
  }

  return;
}

# Get the config file location as Perl::Tidy sees it.
# Returns: absolute path to config file, or 'none' if no config file.
# If --rc is specified, use that value.
# If --no-rc is specified, return 'none'.
# Otherwise, find what Perl::Tidy would use: an --rc or --no-rc among the
# pass-through arguments, then PERLTIDY, then Perl::Tidy's own search.
sub get_config_location {
  my ( $rc_file, $perltidy_args ) = @_;
  $perltidy_args ||= [];

  if ( defined $rc_file ) {

    # A scalar ref means --no-rc was used; otherwise it is the --rc value.
    return 'none' if ref $rc_file eq 'SCALAR';
    return readable_rc($rc_file);
  }

  my ( $kind, $rc_from_args ) = rc_from_passthrough($perltidy_args);
  if ( defined $kind ) {
    return $kind eq 'no-rc' ? 'none' : readable_rc($rc_from_args);
  }

  my $from_env = rc_from_env();
  return $from_env if defined $from_env;

  my $found = find_perltidyrc();
  return $found ? abs_path_of($found) : 'none';
} ## end sub get_config_location

# Show the config file location as Perl::Tidy sees it.
# Prints the result to stdout.
sub show_config_location {
  my ( $rc_file, $perltidy_args ) = @_;
  my $location = get_config_location( $rc_file, $perltidy_args );
  print "$location\n";
  return;
}

# Get Perl::Tidy default options and abbreviations.
# Returns: (\%Opts_default, \%abbreviations_default)
sub get_perltidy_defaults {
  my $stderr     = "";
  my @argv_empty = ();

  my %Opts_default;
  my %abbreviations_default;

  # Build parameter hash explicitly for defaults dump
  my %params_default = (
    perltidyrc         => \"",         # empty scalar ref for empty config
    dump_options       => \%Opts_default,
    dump_options_type  => 'full',
    dump_abbreviations => \%abbreviations_default,
    stderr             => \$stderr,
    argv               => \@argv_empty,
  );

  call_perltidy( \%params_default, 'defaults dump', \$stderr, 'die' );

  return ( \%Opts_default, \%abbreviations_default );
} ## end sub get_perltidy_defaults

# Get Perl::Tidy config options from specified config file and command-line args.
# Parameters:
#   $config_file - Config file path (string), scalar ref (for --no-rc), or undef (use search)
#   $perltidy_args - Array ref of command-line arguments to pass to Perl::Tidy (should be expanded already)
# Returns: ($error_message, \%Opts, \%Getopt_flags, \%sections, \%abbreviations)
sub get_perltidy_config {
  my ( $config_file, $perltidy_args ) = @_;
  $perltidy_args ||= [];
  my $error_message = "";
  my %Opts;
  my %Getopt_flags;
  my %sections;
  my %abbreviations;
  my $stderr = "";

  # Build parameter hash explicitly for config dump
  # Only include perltidyrc if --rc or --no-rc was used (not undef)
  my %params_config = (
    dump_options          => \%Opts,
    dump_options_type     => 'perltidyrc',
    dump_getopt_flags     => \%Getopt_flags,
    dump_options_category => \%sections,
    dump_abbreviations    => \%abbreviations,
    stderr                => \$stderr,
    argv                  => $perltidy_args,  # array ref, even if empty
  );

  # Only add perltidyrc if explicitly specified (--rc or --no-rc)
  # If undef, Perl::Tidy will use its default search behavior
  if ( defined $config_file ) {
    $params_config{perltidyrc} = $config_file;  # filename string or scalar ref
  }

  my ( $err, $config_error ) = call_perltidy( \%params_config, 'parsing options', \$stderr, 'accumulate' );

  # Note: $err (error code: 0=success, 1=error, 2=warnings) is not currently used.
  # The error_message is checked by the caller and causes the script to die if non-empty.
  # This matches the original behavior where warnings in stderr also cause the script to die.
  $error_message .= $config_error;

  return ( $error_message, \%Opts, \%Getopt_flags, \%sections, \%abbreviations );
} ## end sub get_perltidy_config

# Compare options against defaults and return a hash indicating which options
# equal their default values. Used to identify options that can be removed
# when --drop-defaults is enabled.
sub build_equals_default {
  my ( $opts, $defaults ) = @_;
  check_undefined_keys( $opts,     'build_equals_default options' );
  check_undefined_keys( $defaults, 'build_equals_default defaults' ) if $defaults;
  my %equals_default;
  foreach my $long_name ( keys %{$opts} ) {
    my $val = $opts->{$long_name};
    next unless defined $defaults->{$long_name};
    my $default_val = $defaults->{$long_name};
    $equals_default{$long_name} =
         defined($val)
      && defined($default_val)
      && $default_val eq $val;
  }
  return %equals_default;
}

sub user_defined_abbreviations {
  my ( $abbrev, $abbrev_default ) = @_;
  check_undefined_keys( $abbrev,         'user_defined_abbreviations abbreviations' );
  check_undefined_keys( $abbrev_default, 'user_defined_abbreviations defaults' ) if $abbrev_default;
  my %abbrev_user;
  foreach my $key ( keys %{$abbrev} ) {
    next if $abbrev_default->{$key};
    $abbrev_user{$key} = $abbrev->{$key};
  }
  return %abbrev_user;
}

# Split 'name=value' into (name, value); anything else is (itself, undef).
# The name is greedy, so 'a=b=c' splits as ('a=b', 'c').
sub split_name_value {
  my ($option) = @_;
  if ( $option =~ /^(.+)=(.+)$/x ) {
    return ( $1, $2 );
  }
  return ( $option, undef );
}

# Map each single-option abbreviation (short name) to its long name;
# multi-option abbreviations are left out.
sub build_short_to_long {
  my ($abbreviations_default) = @_;
  my %short_to_long;
  foreach my $short ( keys %{$abbreviations_default} ) {
    my @longs = @{ $abbreviations_default->{$short} };
    if ( @longs == 1 ) {
      $short_to_long{$short} = $longs[0];
    }
  }
  return \%short_to_long;
}

# Map each multi-option expansion (its options, sorted and joined) to the
# longest abbreviation name that produces it, across both the default and the
# user-defined abbreviations: when act=0 and all-containers-tightness=0 expand
# to the same options, the longer name wins.
#
# The caller iterates the returned hash, so it is returned by reference: a
# copy would be rebuilt in a different insertion order.
sub build_expansion_to_preferred {
  my ( $abbreviations_default, $abbreviations ) = @_;
  my %expansion_to_preferred;
  my @abbr_sources = ($abbreviations_default);
  push @abbr_sources, $abbreviations if $abbreviations;
  foreach my $abbr_hash (@abbr_sources) {
    foreach my $abbr_key ( keys %{$abbr_hash} ) {
      my @mapped_opts = @{ $abbr_hash->{$abbr_key} };
      next if @mapped_opts < 2;
      my $expansion_key = join( '|', sort @mapped_opts );
      my $current       = $expansion_to_preferred{$expansion_key};
      if ( !defined $current || length($abbr_key) > length($current) ) {
        $expansion_to_preferred{$expansion_key} = $abbr_key;
      }
    }
  }
  return \%expansion_to_preferred;
} ## end sub build_expansion_to_preferred

# Recursively expand an abbreviation to final long option names, as an array
# ref. Handles cases like cti=2 -> cpi=2, cbi=2, csbi=2 ->
# closing-paren-indentation=2, etc. A value on the abbreviation itself
# (cpi=3) is carried onto every option it expands to, replacing any value
# that option already had.
sub expand_abbrev_to_long {
  my ( $abbr, $abbr_hash, $short_to_long_hash ) = @_;
  my ( $base_name, $value ) = split_name_value($abbr);

  # A single-option abbreviation names its long option directly.
  if ( exists $short_to_long_hash->{$base_name} ) {
    my $long_name = $short_to_long_hash->{$base_name};
    return [ defined $value ? "$long_name=$value" : $long_name ];
  }

  # A multi-option abbreviation, matched with any value it carries.
  if ( exists $abbr_hash->{$abbr} ) {
    return [ map { @{ expand_abbrev_to_long( $_, $abbr_hash, $short_to_long_hash ) } } @{ $abbr_hash->{$abbr} } ];
  }

  # Otherwise match on the base name alone (cpi for cpi=3).
  return [] if !exists $abbr_hash->{$base_name};

  my @expanded =
    map { @{ expand_abbrev_to_long( $_, $abbr_hash, $short_to_long_hash ) } } @{ $abbr_hash->{$base_name} };
  return \@expanded if !defined $value;
  return [ map { ( split_name_value($_) )[0] . "=$value" } @expanded ];
} ## end sub expand_abbrev_to_long

# The options an abbreviation maps to, from the defaults first and then the
# user-defined abbreviations, as an array ref; undef when neither has it.
sub abbreviation_options {
  my ( $abbr_key, $abbreviations_default, $abbreviations ) = @_;
  if ( exists $abbreviations_default->{$abbr_key} ) {
    return [ @{ $abbreviations_default->{$abbr_key} } ];
  }
  if ( $abbreviations && exists $abbreviations->{$abbr_key} ) {
    return [ @{ $abbreviations->{$abbr_key} } ];
  }
  return;
}

# Expand each of an abbreviation's options to (long name, value) pairs. An
# option that does not expand is tried as a direct short-to-long mapping, and
# kept without a value if that fails too.
sub long_name_value_pairs {
  my ( $mapped_opt, $abbreviations_default, $short_to_long ) = @_;
  my $expanded = expand_abbrev_to_long( $mapped_opt, $abbreviations_default, $short_to_long );
  return map { [ split_name_value($_) ] } @{$expanded} if @{$expanded};

  my ( $short, $val ) = split_name_value($mapped_opt);
  if ( defined $val && exists $short_to_long->{$short} ) {
    return [ $short_to_long->{$short}, $val ];
  }
  return [ $mapped_opt, undef ];
}

# The long names an abbreviation's options expand to, and the one value they
# all share: (\@long_names, $value). Returns an empty list when any of them
# has no value, the values differ, or nothing expands.
sub collect_long_names {
  my ( $mapped_opts, $abbreviations_default, $short_to_long ) = @_;
  my @long_names;
  my $expected_value;
  foreach my $mapped_opt ( @{$mapped_opts} ) {
    foreach my $pair ( long_name_value_pairs( $mapped_opt, $abbreviations_default, $short_to_long ) ) {
      my ( $long_name, $val ) = @{$pair};
      return if !defined $val;
      return if defined $expected_value && $val ne $expected_value;
      $expected_value = $val;
      push @long_names, $long_name;
    }
  }
  return if !@long_names;
  return ( \@long_names, $expected_value );
}

# True when every named option is present in $opts with the given value.
sub all_opts_equal {
  my ( $opts, $long_names, $expected_value ) = @_;
  foreach my $long_name ( @{$long_names} ) {
    return 0
      if !exists $opts->{$long_name}
      || !defined $opts->{$long_name}
      || $opts->{$long_name} ne $expected_value;
  }
  return 1;
}

# Condense options using abbreviations (e.g., pt=0, sbt=0, bt=0, bbt=0 ->
# act=0): where every option an abbreviation expands to is set to the same
# value, remove them and note that the abbreviation can replace them.
sub condense_options {
  my ( $opts, $sections, $section_notes, $abbreviations, $abbreviations_default ) = @_;
  return if !$abbreviations_default;

  my $short_to_long          = build_short_to_long($abbreviations_default);
  my $expansion_to_preferred = build_expansion_to_preferred( $abbreviations_default, $abbreviations );

  # Iterate through preferred abbreviations only to find condensing
  # opportunities; each value is already the preferred (longest) name.
  foreach my $expansion_key ( keys %{$expansion_to_preferred} ) {
    my $abbr_key    = $expansion_to_preferred->{$expansion_key};
    my $mapped_opts = abbreviation_options( $abbr_key, $abbreviations_default, $abbreviations );
    next if !$mapped_opts;

    my ( $long_names, $expected_value ) = collect_long_names( $mapped_opts, $abbreviations_default, $short_to_long );
    next if !$long_names;

    # Skip if the abbreviation carries a value of its own that differs.
    my ( undef, $abbr_value ) = split_name_value($abbr_key);
    next if defined $abbr_value && $abbr_value ne $expected_value;

    next if !all_opts_equal( $opts, $long_names, $expected_value );

    # Remove the individual options and add notes
    # Note: We don't add the abbreviation itself to $opts since abbreviations
    # are not valid option names - they expand to multiple options.
    # The user can use the abbreviation when writing the config file if desired.
    foreach my $long_name ( @{$long_names} ) {
      add_section_note(
        $sections, $section_notes, $long_name,
        "$long_name removed; can be condensed to $abbr_key"
      );
      delete $opts->{$long_name};
    }
  } ## end foreach my $expansion_key (...)

  return;
} ## end sub condense_options

sub detect_conflicts {
  my ( $opts, $sections, $section_notes ) = @_;
  $section_notes ||= {};

  if ( is_true( $opts->{'brace-left-and-indent'} )
    && is_true( $opts->{'non-indenting-braces'} ) ) {
    add_section_note(
      $sections, $section_notes, 'brace-left-and-indent',
      "brace-left-and-indent conflicts with non-indenting-braces"
    );
  }

  if ( is_true( $opts->{tabs} )
    && is_true( $opts->{'entab-leading-whitespace'} ) ) {
    add_section_note(
      $sections, $section_notes, 'tabs',
      "tabs together with entab-leading-whitespace may conflict"
    );
  }

  if ( defined $opts->{'brace-tightness'} ) {
    my $general = $opts->{'brace-tightness'};
    foreach my $specific (
      qw(block-brace-tightness brace-vertical-tightness
      brace-vertical-tightness-closing brace-follower-vertical-tightness
      block-brace-vertical-tightness)
    ) {
      next unless defined $opts->{$specific};
      if ( $opts->{$specific} ne $general ) {
        add_section_note(
          $sections, $section_notes, $specific,
          "$specific differs from brace-tightness; specific wins"
        );
      }
    }
  }

  if ( defined $opts->{'maximum-line-length'}
    && defined $opts->{'fuzzy-line-length'} ) {
    my $max   = $opts->{'maximum-line-length'};
    my $fuzzy = $opts->{'fuzzy-line-length'};
    if ( looks_like_integer($max)
      && looks_like_integer($fuzzy)
      && $fuzzy > $max ) {
      add_section_note(
        $sections, $section_notes, 'fuzzy-line-length',
        "fuzzy-line-length ($fuzzy) exceeds maximum-line-length ($max)"
      );
    }
  }

  if (
       exists $opts->{format}
    && !is_true( $opts->{format} )
    && ( is_true( $opts->{'format-skipping'} )
      || is_true( $opts->{'detect-format-skipping-from-start'} ) )
  ) {
    add_section_note(
      $sections, $section_notes, 'format',
      "format is disabled but format-skipping detection is enabled"
    );
  }

  return;
} ## end sub detect_conflicts

# Render one option as a perltidyrc line (without the newline): --name,
# --no-name for a false negatable flag, or --name=value with the value quoted
# unless it is all digits. An unrecognised getopt flag is reported through
# $append as it is met, ahead of the option itself.
sub format_option {
  my ( $long_name, $value, $flag, $append ) = @_;
  my ( $prefix, $suffix ) = ( '--', '' );
  if ($flag) {
    if ( $flag =~ /^[=:]/x ) {
      if ( $value !~ /^\d+$/x ) {
        $value = '"' . $value . '"';
      }
      $suffix = '=' . $value;
    } elsif ( $flag =~ /^!/x ) {
      $prefix .= 'no-' unless $value;
    } else {
      $append->("# ERROR in dump_options: unrecognized flag $flag for $long_name\n");
    }
  }
  return $prefix . $long_name . $suffix;
}

# Emit one section: its heading and notes (unless quiet), then its options in
# name order, each marked when it equals its default under --keep-defaults.
sub dump_section {
  my ( $args, $section, $rname_value, $append ) = @_;

  unless ( $args->{quiet} ) {
    $append->("\n");
    ( my $trimmed = $section ) =~ s/^\d+\.[ ]//x;
    $append->("# $trimmed\n");
    my $notes = $args->{section_notes}->{$section};
    $append->("# NOTE: $_\n") for @{ $notes || [] };
  }

  check_undefined_keys( $rname_value, "dump_options section '$section'" ) if $rname_value;
  foreach my $long_name ( sort keys %{$rname_value} ) {
    my $long_option =
      format_option( $long_name, $rname_value->{$long_name}, $args->{getopt_flags}->{$long_name}, $append );

    if ( $args->{keep_defaults} && $args->{equals_default}->{$long_name} ) {
      my $padding = 40 - length($long_option);
      $padding = 2 if $padding < 2;    # Minimum 2 spaces
      $long_option .= ' ' x $padding . "#  default";
    }
    $append->( $long_option . "\n" );
  }

  return;
} ## end sub dump_section

sub dump_options {
  my (%args) = @_;

  my $destination = $args{destination};  # scalar ref or undef
  $args{section_notes} //= {};

  check_undefined_keys( $args{opts},               'dump_options opts' )               if $args{opts};
  check_undefined_keys( $args{sections},           'dump_options sections' )           if $args{sections};
  check_undefined_keys( $args{abbreviations_user}, 'dump_options abbreviations_user' ) if $args{abbreviations_user};
  my %section_and_name;
  my %saw_section;
  foreach my $long_name ( keys %{ $args{opts} } ) {
    my $section = $args{sections}->{$long_name} // 'UNKNOWN';
    $section_and_name{$section}{$long_name} = $args{opts}->{$long_name};
    $saw_section{$section}++;
  }

  my $append = sub {
    my ($text) = @_;
    if ($destination) {
      $$destination .= $text;
    } else {
      print $text;
    }
  };

  unless ( $args{quiet} ) {
    my $date = localtime();
    $append->("# perltidy configuration file created $date\n");
    $append->("# using: $args{cmdline}\n");
    $append->("# source: $args{rc_origin}\n");
  }

  foreach my $section ( sort { section_order($a) <=> section_order($b) || $a cmp $b } keys %saw_section ) {
    dump_section( \%args, $section, $section_and_name{$section}, $append );
  }

  if ( %{ $args{abbreviations_user} } ) {
    unless ( $args{quiet} ) {
      $append->("\n");
      $append->("# Abbreviations\n");
    }
    foreach my $key ( sort keys %{ $args{abbreviations_user} } ) {
      my @vals = @{ $args{abbreviations_user}->{$key} };
      $append->( $key . ' {' . join( ' ', @vals ) . '}' . "\n" );
    }
  }

  return;
} ## end sub dump_options

# ------------------------------------------------------------------------------
# Main Program
# ------------------------------------------------------------------------------

# Parse this script's own options into %cli. Anything not recognised stays in
# @ARGV to be passed through to Perl::Tidy.
sub parse_cli {
  GetOptions(
    'rc=s'                   => \$cli{rc},
    'no-rc'                  => \$cli{no_rc},
    'keep-defaults'          => \&set_keep_defaults,
    'add-missing-defaults'   => \&set_add_missing_defaults,
    'condense!'              => \$cli{condense},
    'quiet|q'                => \$cli{quiet},
    'showconfig'             => \$cli{showconfig},
    'overwrite'              => \$cli{overwrite},
    'dump-perltidy-defaults' => \$cli{dump_perltidy_defaults},
    'dump-perltidy-config'   => \$cli{dump_perltidy_config},
    'help|h'                 => sub { usage(0) },
  ) or usage(1);

  # Fail fast on mutually exclusive flags.
  if ( $cli{rc} && $cli{no_rc} ) {
    die "--rc and --no-rc are mutually exclusive\n";
  }

  return;
} ## end sub parse_cli

# The config file source for Perl::Tidy: an empty profile for --no-rc, the
# --rc file, or undef to let Perl::Tidy search.
sub rc_source {
  return \$empty  if $cli{no_rc};
  return $cli{rc} if $cli{rc};
  return;
}

# Validate --overwrite requirements and conflicts, then aim the output at the
# --rc file.
sub validate_overwrite {
  return if !$cli{overwrite};

  unless ( $cli{rc} ) {
    die "--overwrite requires --rc to be specified\n";
  }
  if ( $cli{outfile} ) {
    die "--overwrite and --outfile are mutually exclusive\n";
  }

  $cli{outfile} = $cli{rc};
  return;
}

# Debugging aid for the --dump-perltidy-* options: print $preamble, then each
# (label, structure) pair through Data::Dumper, then exit.
sub dump_and_exit {
  my ( $preamble, @labelled ) = @_;
  eval { require Data::Dumper; 1 }
    or die "Data::Dumper not installed\n";
  print $preamble;
  my $separator = '';
  while ( my ( $label, $data ) = splice @labelled, 0, 2 ) {
    print "$separator$label:\n";
    print Data::Dumper->new( [$data] )->Indent(1)->Sortkeys(1)->Terse(1)->Dump;
    $separator = "\n";
  }
  exit 0;
}

# Fill %$clean_opts with the option set to emit: defaults overlaid with the
# loaded options for --no-rc or --add-missing-defaults; otherwise the loaded
# options, less any equal to their default when defaults are being dropped.
sub build_clean_opts {
  my ( $clean_opts, $rOpts, $rOpts_default, $equals_default ) = @_;

  if ( $cli{no_rc} || $cli{add_missing_defaults} ) {
    %{$clean_opts} = ( %{$rOpts_default}, %{$rOpts} );
    return;
  }

  %{$clean_opts} = %{$rOpts};
  if ( $cli{drop_defaults} ) {
    foreach my $long_name ( keys %{$clean_opts} ) {
      delete $clean_opts->{$long_name} if $equals_default->{$long_name};
    }
  }

  return;
}

# Write the output to --outfile (or the --overwrite target), else stdout.
sub write_output {
  my ($output) = @_;
  if ( $cli{outfile} ) {
    open my $fh, '>', $cli{outfile}
      or die "Cannot open $cli{outfile} for writing: $!\n";
    print $fh $output;
    close $fh;
  } else {
    print $output;
  }
  return;
}

sub main {
  parse_cli();

  # Determine config file source (used by both --showconfig and main processing)
  my $rc_source = rc_source();

  # Get the actual config file location for $rc_origin
  my $rc_origin =
    $cli{no_rc}
    ? 'none (empty profile)'
    : get_config_location( $rc_source, \@ARGV );

  # Handle --showconfig early (after --help check, before other processing)
  if ( $cli{showconfig} ) {
    show_config_location( $rc_source, \@ARGV );
    exit 0;
  }

  # Extract outfile before any perltidy handling; remaining args pass through.
  # Extract from @ARGV since we'll pass @ARGV to Perl::Tidy
  $cli{outfile} = extract_outfile( \@ARGV );
  validate_overwrite();

  # Clean @ARGV: filter out file arguments since we're only dumping options,
  # not processing source files. Keep only option-like arguments for Perl::Tidy.
  # GetOptions already removed our CLI options, so @ARGV contains pass-through args.
  local @ARGV = grep { /^-/x } @ARGV;  # Keep only option-like arguments

  my ( $rOpts_default, $rabbreviations_default ) = get_perltidy_defaults();
  if ( $cli{dump_perltidy_defaults} ) {
    dump_and_exit(
      '',
      Opts_default          => $rOpts_default,
      abbreviations_default => $rabbreviations_default,
    );
  }

  my ( $error_message, $rOpts, $rGetopt_flags, $rsections, $rabbreviations ) = get_perltidy_config( $rc_source, \@ARGV );
  if ( $cli{dump_perltidy_config} ) {
    dump_and_exit(
      'error_message: ' . ( $error_message || '(empty)' ) . "\n\n",
      Opts          => $rOpts,
      Getopt_flags  => $rGetopt_flags,
      sections      => $rsections,
      abbreviations => $rabbreviations,
    );
  }

  # Re-terminated so die adds no location. Perl::Tidy's messages already end
  # in a newline, so they print exactly as Perl::Tidy wrote them.
  if ($error_message) {
    chomp( my $message = $error_message );
    die "$message\n";
  }

  my %equals_default = build_equals_default( $rOpts, $rOpts_default );
  my %section_notes;
  my %clean_opts;
  build_clean_opts( \%clean_opts, $rOpts, $rOpts_default, \%equals_default );

  %equals_default = build_equals_default( \%clean_opts, $rOpts_default );

  condense_options( \%clean_opts, $rsections, \%section_notes, $rabbreviations, $rabbreviations_default )
    if $cli{condense};

  detect_conflicts( \%clean_opts, $rsections, \%section_notes );

  my %abbreviations_user = user_defined_abbreviations( $rabbreviations, $rabbreviations_default );

  if ( %clean_opts || %abbreviations_user ) {
    my $output = "";
    dump_options(
      quiet              => $cli{quiet},
      cmdline            => join( ' ', basename($0), @original_argv ),
      rc_origin          => $rc_origin,
      opts               => \%clean_opts,
      getopt_flags       => $rGetopt_flags,
      sections           => $rsections,
      abbreviations      => $rabbreviations,
      equals_default     => \%equals_default,
      abbreviations_user => \%abbreviations_user,
      section_notes      => \%section_notes,
      keep_defaults      => $cli{keep_defaults},
      destination        => \$output,
    );
    write_output($output);
  } else {
    print STDERR "No configuration parameters remain after filtering.\n";
  }

  exit 0;
} ## end sub main

main();

__END__

=head1 NAME

perltidyrc-clean - clean, condense, and validate a perltidyrc configuration

=head1 SYNOPSIS

  perltidyrc-clean [--rc FILE | --no-rc] [--keep-defaults]
                   [--add-missing-defaults] [--[no-]condense]
                   [--outfile FILE | --overwrite] [--quiet]
                   [--showconfig] [--help]

  # Clean the perltidyrc Perl::Tidy would find and print to stdout
  perltidyrc-clean

  # Clean a specific file in place
  perltidyrc-clean --rc .perltidyrc --overwrite

  # Report which perltidyrc Perl::Tidy resolves, then exit
  perltidyrc-clean --showconfig

=head1 DESCRIPTION

Loads a perltidyrc (via Perl::Tidy's own resolution, or the file named by
C<--rc>), then emits a cleaned version: options matching Perl::Tidy defaults
are dropped (unless C<--keep-defaults>), fine-grained options that duplicate a
broader setting are condensed into that setting (unless C<--no-condense>),
conflicting or shadowed options are annotated, and the result is regrouped by
the Formatting Options sections of the perltidy manual.

The cleaned configuration is written to stdout by default, to C<--outfile>, or
back over the source file with C<--overwrite>. Any arguments not recognised as
options above are passed through to Perl::Tidy, which reports an error if it
does not recognise them.

Requires Perl::Tidy (version 20060528 or newer) at runtime.

=head1 OPTIONS

=over 4

=item B<--rc> I<FILE>

Load I<FILE> as the perltidyrc instead of letting Perl::Tidy search.

=item B<--no-rc>

Do not load any perltidyrc; process from Perl::Tidy defaults, overlaying any
options passed through.

=item B<--keep-defaults>

Keep options whose values match Perl::Tidy defaults (normally dropped). Does
not add missing defaults.

=item B<--add-missing-defaults>

Add any missing default options. Implies C<--keep-defaults> and
C<--no-condense>.

=item B<--condense>, B<--no-condense>

Condense fine-grained options that duplicate a broader setting (on by
default; disable with C<--no-condense>).

=item B<--outfile> I<FILE>, B<-o> I<FILE>

Write the output to I<FILE> instead of stdout. Mutually exclusive with
C<--overwrite>.

=item B<--overwrite>

Overwrite the C<--rc> file with the cleaned output. Requires C<--rc>.

=item B<--quiet>, B<-q>

Omit the header and per-section comments from the output.

=item B<--showconfig>

Print the perltidyrc location as Perl::Tidy resolves it (the C<--rc> file if
given, else the searched result) and exit. All options except C<--help> are
ignored.

=item B<--dump-perltidy-defaults>, B<--dump-perltidy-config>

Debugging aids: dump Perl::Tidy's default option set, or the resolved option
set for the current invocation, then exit.

=item B<--help>, B<-h>

Show the usage message and exit.

=back

=head1 EXIT STATUS

Exits C<0> on success (including C<--showconfig>, C<--help>, and the C<--dump->
modes). Exits non-zero via C<die> on a usage error (e.g. C<--overwrite>
without C<--rc>, or mutually exclusive options), a missing Perl::Tidy, or an
I/O failure writing the output.

=cut
