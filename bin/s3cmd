#!/usr/bin/env bash

# s3cmd - run the s3cmd found later on PATH, even where its own launcher
# cannot be run by name.
#
# On Windows, `uv tool install s3cmd` writes s3cmd as a Python script whose
# #! line is a Windows path (#!C:\...\Scripts\python.exe), which Git Bash
# cannot exec. When the real s3cmd has such a line, this runs it with that
# interpreter instead; anywhere else it just execs the real s3cmd.
#
# That Windows Python also needs PATH without Git's /usr/bin. s3cmd imports
# python-magic, which searches PATH for a libmagic DLL and accepts MSYS's
# msys-magic-1.dll; loading an MSYS DLL into a native Python hangs or
# segfaults it. Without one, python-magic fails cleanly and s3cmd carries on
# without it.

set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"

# PATH minus any directory holding an MSYS or Cygwin libmagic.
path_without_msys_magic() {
  local dir
  local -a keep=()

  local IFS=:
  for dir in $PATH; do
    [[ -e "$dir/msys-magic-1.dll" || -e "$dir/cygmagic-1.dll" ]] || keep+=("$dir")
  done

  printf '%s' "${keep[*]}"
}

real=''
while IFS= read -r candidate; do
  if [[ "$(readlink -f "$candidate")" != "$self" ]]; then
    real="$candidate"
    break
  fi
done < <(type -ap s3cmd)

if [[ -z $real ]]; then
  echo "${0##*/}: no s3cmd on PATH besides this wrapper" >&2
  exit 127
fi

IFS= read -r first < "$real" || true
first="${first%$'\r'}"

if [[ $first =~ ^#!([A-Za-z]:\\.*)$ ]]; then
  python="$(cygpath -u "${BASH_REMATCH[1]}")"
  PATH="$(path_without_msys_magic)" exec "$python" "$real" "$@"
fi

exec "$real" "$@"
