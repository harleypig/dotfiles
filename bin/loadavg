#!/usr/bin/env bash
#
# loadavg - the 15 minute load average, for the bash prompt
#
# Usage: loadavg [loadavg_file]
#
# Prints "Load Avg: <n>" with no newline when the 15 minute load is above
# one per CPU: yellow, or yellow on red above two per CPU. Prints nothing
# otherwise, so the prompt only grows a line while the machine is busy, and
# nothing where loadavg_file (default /proc/loadavg) cannot be read or does
# not parse.

set -euo pipefail

if (($# > 1)); then
  echo "Usage: ${0##*/} [loadavg_file]" >&2
  exit 2
fi

self=$(readlink -f "${BASH_SOURCE[0]}") || exit 0

# shellcheck source=/dev/null
source "${self%/*}/../lib/loadavg" 2> /dev/null || exit 0

loads=() levels=()
loadavg_classify loads levels "${1:-}" || exit 0

case ${levels[2]} in
  alert) color=$(ansi -n fg yellow bg red) ;;
  warn) color=$(ansi -n fg yellow) ;;
  *) exit 0 ;;
esac

printf '%sLoad Avg: %s%s' "$color" "${loads[2]}" "$(ansi -n off)"
