#!/usr/bin/bash

# Run docker, npx, or whatever command is needed to start a local mcp server.

###############################################################################
# Setup and sanity

# I don't normally use this, but we want cursor to handle this gracefully
# (ish).
set -euo pipefail

selfname="${0##*/}"

echo "0: $0 ::: $PWD ::: $* <<<" >&2

# Use $DOTFILES for log directory
: "${DOTFILES:?DOTFILES environment variable is not set}"
log_dir="$DOTFILES/.mymcp"

# Per-server API tokens live in the private api-key store, alongside the
# dotfiles checkout. Each server reads the file it needs directly (see
# read_api_key); servers that share permission needs read the same file.
api_key_dir="${PROJECTS_DIR:-$(dirname "$DOTFILES")}/private_dotfiles/api-key"

# Create log directory if it doesn't exist
mkdir -p "$log_dir"

# Shared error helpers (dw_warn / dw_die). DW_TAG prefixes each line;
# DW_LOG routes output to our per-run log file instead of stderr.
# shellcheck source=/dev/null
source "$DOTFILES/lib/docker_helpers"
export DW_TAG="[$selfname] "

# Initialize the log file (updated with the command name once known).
# Use the first argument as a fallback for early warnings.
log_timestamp="$(date +%y%m%d-%H%M%S)"
cmd_fallback="${1:-unknown}"
export DW_LOG="$log_dir/mymcp-$cmd_fallback-$log_timestamp.log"

declare -A known_cmd

###############################################################################
# Utility Functions

#------------------------------------------------------------------------------
# Read a token from the private api-key store. Give a server its own file
# only when its access needs differ; servers with the same needs pass the
# same name and share one token.
read_api_key() {
  local name="$1"
  local file="$api_key_dir/$name"

  [[ -r $file ]] || dw_die 1 "api-key file not found or unreadable: $file"

  printf '%s' "$(< "$file")"
}

#------------------------------------------------------------------------------
docker_run() {
  local opts=('run' '--rm' '-i' "$@")
  dw_warn "docker ${opts[*]}"
  exec docker "${opts[@]}"
}

#------------------------------------------------------------------------------
npx_run() {
  local opts=('-y' "$@")
  dw_warn "npx ${opts[*]}"
  exec npx "${opts[@]}"
}

###############################################################################
# MCP Servers

# https://github.com/github/github-mcp-server/blob/main/docs/server-configuration.md
github() {
  export GITHUB_PERSONAL_ACCESS_TOKEN
  GITHUB_PERSONAL_ACCESS_TOKEN="$(read_api_key mcp-github)"
  docker_run \
    '-e' 'GITHUB_PERSONAL_ACCESS_TOKEN' \
    'ghcr.io/github/github-mcp-server' \
    'stdio' \
    '--dynamic-toolsets' \
    '--tools=get_me,search_code'
}

known_cmd['github']=1

#------------------------------------------------------------------------------
snyk() {
  npx_run 'snyk@latest' 'mcp' '-t' 'stdio'
}

known_cmd['snyk']=1

#------------------------------------------------------------------------------
# https://github.com/upstash/context7 (package: @upstash/context7-mcp).
# Replaces the marketplace context7 plugin so the server is owned and
# versioned here. context7 is wanted globally, so register it once at
# user scope (MCP servers are not configured in settings.json):
#   claude mcp add context7 --scope user -- mymcp context7
# The API key is read from the private store and passed via the env var
# the server reads (so it no longer needs exporting into every shell).
context7() {
  export CONTEXT7_API_KEY
  CONTEXT7_API_KEY="$(read_api_key context7)"
  npx_run '@upstash/context7-mcp'
}

known_cmd['context7']=1

#------------------------------------------------------------------------------
# https://github.com/Pimzino/spec-workflow-mcp
spec_workflow() {
  npx_run "@pimzino/spec-workflow-mcp@latest" "$@"
}

spec_dashboard() { spec_workflow --dashboard; }
spec_client() { spec_workflow "$@"; }

known_cmd['spec_dashboard']=1
known_cmd['spec_client']=1

#------------------------------------------------------------------------------
# https://github.com/oraios/serena — dockerized stdio MCP server (coding-agent
# toolkit driving language servers over your code). Runs the official image
# headless: stdio transport with the web dashboard disabled, so no port or
# --network host is needed. The projects tree ($PROJECTS_DIR) is mounted
# read-write at /workspaces/projects so serena can operate on your code (refer
# to a project by its in-container path, e.g. /workspaces/projects/<name>).
# Serena's own state — config, logs, and the downloaded language servers (the
# image's SERENA_HOME=/workspaces/serena/config) — lives in the named docker
# volume `serena-config` (auto-created on first run), so there is NO host
# ~/.serena footprint and language servers are not re-downloaded each session.
# Register once at user scope (MCP servers are not configured in settings.json):
#   claude mcp add serena --scope user -- mymcp serena
# NOTE: the container runs as root (its config volume is root-initialized, so
# --user cannot write it). Activating a project therefore writes a root-owned
# <project>/.serena/ into it; redirect that via project_serena_folder_location
# in the volume's serena_config.yml to keep host projects clean.
serena() {
  docker_run \
    '-v' "${PROJECTS_DIR:-$(dirname "$DOTFILES")}:/workspaces/projects" \
    '-v' 'serena-config:/workspaces/serena/config' \
    'ghcr.io/oraios/serena:latest' \
    'serena' 'start-mcp-server' \
    '--transport' 'stdio' \
    '--enable-web-dashboard' 'false'
}

known_cmd['serena']=1

#------------------------------------------------------------------------------
# https://docs.superhuman.com/apis/mcp — Superhuman Docs, a REMOTE http MCP
# server. mymcp execs a local stdio process, so it cannot host an http
# server directly; mcp-remote bridges the two (stdio to the client, https
# to Superhuman). Auth is a Personal Access Token (restriction type MCP)
# read from the private store, so the token at rest lives only in
# api-key/superhuman and never in .claude.json (the native
# `--header "Authorization: Bearer <token>"` registration persists it there).
#
# LIMITATION: mcp-remote does not read the header from the environment nor
# expand ${VAR} inside a --header value — the shell must expand it — so,
# unlike github() which hands its token to the container via an env var,
# the PAT is passed as an argv element and is visible in `ps` /
# /proc/<pid>/cmdline while the process runs (same-user/root only, and
# ephemeral).
#
# Register once at LOCAL scope in the repo that needs it (docs lookup is
# per-repo, like context7 — MCP servers are not configured in settings.json):
#   claude mcp add SuperhumanDocs -- mymcp superhuman
# NOTE: the server also advertises OAuth; if a client ignores this header and
# falls back to OAuth discovery, that is the known upstream quirk to check.
superhuman() {
  local token nvm_dir node_default node_bin

  # mcp-remote needs Node >=20.18.1, but Claude Code execs mymcp directly, so
  # the login shims that lazy-load nvm and put its Node on PATH never run —
  # npx would resolve to an old system Node. Select nvm's default Node here
  # (fail fast if the toolchain isn't provisioned: vmgr install node).
  nvm_dir="${NVM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/nvm}"

  local alias_file="$nvm_dir/alias/default"
  [[ -r $alias_file ]] && node_default="$(< "$alias_file")"
  [[ -n $node_default ]] \
    || dw_die 1 "no nvm default Node (run: vmgr install node)"

  node_bin="$nvm_dir/versions/node/$node_default/bin"
  [[ -x $node_bin/npx ]] \
    || dw_die 1 "Node $node_default npx not found at $node_bin"

  PATH="$node_bin:$PATH"

  token="$(read_api_key superhuman)"

  npx_run 'mcp-remote' 'https://docs.superhuman.com/apis/mcp' \
    '--header' "Authorization: Bearer $token"
}

known_cmd['superhuman']=1

#------------------------------------------------------------------------------
(($#)) || dw_die 2 "Usage: $selfname <${!known_cmd[*]}>"

cmd="$1"
[[ -v "known_cmd[$cmd]" ]] || dw_die 2 "Unknown option: $1"
shift

# Update the log file with the actual command name.
DW_LOG="$log_dir/mymcp-$cmd-$log_timestamp.log"

"$cmd" "$@"
