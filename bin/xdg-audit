#!/usr/bin/env perl
use strict;
use warnings;
use Getopt::Long qw(:config bundling no_ignore_case);
use File::Spec;
use Digest::SHA qw(sha256_hex);
use FindBin     qw($RealBin);
use JSON::PP;

# ------------------------------------------------------------------------------
# xdg-audit — audit $HOME for dotfiles that could move to XDG locations.
#
# Data model: a PRISTINE vendored mirror of xdg-ninja (json-schema/ + programs/)
# plus a local overlay (programs-local/) that overrides/adds/ignores entries and
# annotates each with a handling mechanism. See config/xdg-audit/README.md.
#
# Core modules only (JSON::PP, Getopt::Long, File::Spec, Digest::SHA, FindBin),
# so this runs on system perl with no CPAN/perlbrew dependency.
# ------------------------------------------------------------------------------

my $PROG = 'xdg-audit';

# Program data (help text) and our output are UTF-8; add the encoding layer so
# wide characters print without warnings.
binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

# ------------------------------------------------------------------------------
# Settings
# ------------------------------------------------------------------------------

my %cli = (
  json      => 0,
  all       => 0,
  db        => undef,
  home      => undef,
  search    => undef,
  mechanism => undef,
  movable   => undef,                  # tri-state: undef=any, 1=only movable, 0=only immovable
  reindex   => 0,
  update_db => 0,
  remove    => 0,
  migrate   => 0,
  fix       => 0,
);

# ------------------------------------------------------------------------------
# Utility subroutines
# ------------------------------------------------------------------------------

# The XDG base directories, with spec defaults when unset. $XDG_CONFIG_HOME in
# this setup points at $DOTFILES/config, so we honour the environment first.
sub xdg_dirs {
  my $home = home_dir();
  my %dirs = (
    HOME            => $home,
    XDG_CONFIG_HOME => $ENV{XDG_CONFIG_HOME} || "$home/.config",
    XDG_CACHE_HOME  => $ENV{XDG_CACHE_HOME}  || "$home/.cache",
    XDG_DATA_HOME   => $ENV{XDG_DATA_HOME}   || "$home/.local/share",
    XDG_STATE_HOME  => $ENV{XDG_STATE_HOME}  || "$home/.local/state",
    XDG_RUNTIME_DIR => $ENV{XDG_RUNTIME_DIR} || "$home/.cache",
  );

  # $DOTFILES anchors symlink `rewrite` targets and dotlinks-file sources, so
  # expand_path must know it — but only when set (an unset $DOTFILES leaves the
  # literal ${DOTFILES} in place, exactly as any other unknown var does).
  $dirs{DOTFILES} = $ENV{DOTFILES} if defined $ENV{DOTFILES} && length $ENV{DOTFILES};

  return \%dirs;
} ## end sub xdg_dirs

sub home_dir {
  return $cli{home} if defined $cli{home};
  return $ENV{HOME} if defined $ENV{HOME} && length $ENV{HOME};
  die "$PROG: \$HOME is not set (pass --home)\n";
}

# Expand $VAR / ${VAR} references (HOME + XDG_*) in a db path to an absolute one.
sub expand_path {
  my ($path) = @_;
  my $dirs = xdg_dirs();
  $path =~ s{\$\{(\w+)\}}{ $dirs->{$1} // "\${$1}" }ge;
  $path =~ s{\$(\w+)}{ $dirs->{$1} // "\$$1" }ge;
  return $path;
}

# Resolve the database directory: --db, then $XDG_AUDIT_HOME, then
# $XDG_CONFIG_HOME/xdg-audit, then the repo copy relative to this script.
sub db_dir {
  return $cli{db}             if defined $cli{db};
  return $ENV{XDG_AUDIT_HOME} if defined $ENV{XDG_AUDIT_HOME};

  if ( defined $ENV{XDG_CONFIG_HOME} ) {
    my $d = File::Spec->catdir( $ENV{XDG_CONFIG_HOME}, 'xdg-audit' );
    return $d if -d $d;
  }

  my $repo = File::Spec->catdir( $RealBin, File::Spec->updir, 'config', 'xdg-audit' );
  return $repo if -d $repo;

  die "$PROG: cannot locate the xdg-audit database (pass --db DIR)\n";
}

sub read_file {
  my ($path) = @_;
  open my $fh, '<:encoding(UTF-8)', $path or die "$PROG: cannot read $path: $!\n";
  local $/;
  my $content = <$fh>;
  close $fh;
  return $content;
}

sub decode_file {
  my ($path) = @_;
  return JSON::PP->new->utf8(0)->decode( read_file($path) );
}

# ------------------------------------------------------------------------------
# Database loading
# ------------------------------------------------------------------------------

# Cheap name -> file map from a directory listing (no JSON parsed). The filename
# stem is the app name, so a single app's file can be loaded on its own.
sub name_index {
  my ($subdir) = @_;
  my $dir = File::Spec->catdir( db_dir(), $subdir );
  my %map;
  return \%map unless -d $dir;

  opendir my $dh, $dir or die "$PROG: cannot open $dir: $!\n";
  for my $f ( readdir $dh ) {
    next unless $f =~ /^(.+)\.json$/;
    next if $f     =~ /^\./;           # skip .schema.json and other dotfiles
    $map{$1} = File::Spec->catfile( $dir, $f );
  }
  closedir $dh;
  return \%map;
}

# Normalise one raw program JSON into flat per-path entries. `files[]` are paths
# that need handling or carry help; the top-level `ignore[]` (overlay only) is a
# list of paths deliberately left in place.
sub entries_from_program {
  my ( $data, $name, $source, $relfile ) = @_;
  my @out;
  for my $file ( @{ $data->{files} || [] } ) {
    push @out, {
      name      => $name,
      source    => $source,
      file      => $relfile,
      path      => $file->{path},
      movable   => $file->{movable} ? JSON::PP::true : JSON::PP::false,
      help      => $file->{help},
      mechanism => $file->{mechanism},
      env       => $file->{env},
      rewrite   => $file->{rewrite},
      owner     => $file->{owner},
      ignore    => 0,
    };
  }
  for my $ig ( @{ $data->{ignore} || [] } ) {

    # An ignore item is either a bare path string or {path, reason}.
    my ( $path, $reason ) = ref $ig eq 'HASH' ? ( $ig->{path}, $ig->{reason} ) : ( $ig, undef );
    push @out, {
      name    => $name,
      source  => $source,
      file    => $relfile,
      path    => $path,
      movable => JSON::PP::false,
      ignore  => 1,
      reason  => $reason,
    };
  }
  return @out;
} ## end sub entries_from_program

# An override replaces the upstream entry, so a minimal overlay would lose the
# upstream help/movable. Backfill those per path (matched by path) from the
# upstream entry when the overlay omits them.
sub backfill_from_upstream {
  my ( $odata, $udata ) = @_;
  my %up = map { $_->{path} => $_ } @{ $udata->{files} || [] };
  for my $f ( @{ $odata->{files} || [] } ) {
    my $u = $up{ $f->{path} } or next;
    $f->{help}    //= $u->{help};
    $f->{movable} //= $u->{movable};
  }
  return $odata;
}

# Load a single app by name (no full-db scan, no index). Overlay wins over
# upstream for the same name; an override backfills upstream help/movable.
sub load_app {
  my ($name)   = @_;
  my $upstream = name_index('programs');
  my $local    = name_index('programs-local');

  my ( $file, $source );
  if ( exists $local->{$name} ) {
    ( $file, $source ) = ( $local->{$name}, exists $upstream->{$name} ? 'override' : 'local' );
  } elsif ( exists $upstream->{$name} ) {
    ( $file, $source ) = ( $upstream->{$name}, 'upstream' );
  } else {
    return;
  }

  my $data = decode_file($file);
  $data->{name} //= $name;
  if ( $source eq 'override' ) {
    my $udata = eval { decode_file( $upstream->{$name} ) };
    backfill_from_upstream( $data, $udata ) if $udata;
  }
  return [ entries_from_program( $data, $name, $source, $file ) ];
} ## end sub load_app

# Merge upstream + overlay into the full flat entry list (overlay wins by name).
sub load_all_entries {
  my $upstream = name_index('programs');
  my $local    = name_index('programs-local');

  my %by_name;
  for my $name ( keys %$upstream ) {
    $by_name{$name} = { file => $upstream->{$name}, source => 'upstream' };
  }
  for my $name ( keys %$local ) {
    $by_name{$name} = {
      file   => $local->{$name},
      source => ( exists $upstream->{$name} ? 'override' : 'local' ),
    };
  }

  my @entries;
  for my $name ( sort keys %by_name ) {
    my $info = $by_name{$name};
    my $data = eval { decode_file( $info->{file} ) };
    if ( !$data ) {
      warn "$PROG: skipping malformed $info->{file}: $@";
      next;
    }
    if ( $info->{source} eq 'override' ) {
      my $udata = eval { decode_file( $upstream->{$name} ) };
      backfill_from_upstream( $data, $udata ) if $udata;
    }
    push @entries, entries_from_program( $data, $name, $info->{source}, $info->{file} );
  }
  return \@entries;
} ## end sub load_all_entries

# ------------------------------------------------------------------------------
# Enriched index (cache) — powers scan / reverse-path lookup / structured filters
# without parsing every body on each run. Rebuilt when stale.
# ------------------------------------------------------------------------------

sub index_path { return File::Spec->catfile( db_dir(), '.index.json' ) }

# Newest mtime across the two program dirs and their files.
sub sources_mtime {
  my $newest = 0;
  for my $sub (qw(programs programs-local)) {
    my $dir = File::Spec->catdir( db_dir(), $sub );
    next unless -d $dir;
    my $m = ( stat $dir )[9] // 0;
    $newest = $m if $m > $newest;
    opendir my $dh, $dir or next;
    for my $f ( readdir $dh ) {
      next if $f eq '.' || $f eq '..';
      my $fm = ( stat File::Spec->catfile( $dir, $f ) )[9] // 0;
      $newest = $fm if $fm > $newest;
    }
    closedir $dh;
  }
  return $newest;
}

sub index_is_stale {
  my $idx = index_path();
  return 1 unless -f $idx;
  my $idx_m = ( stat $idx )[9] // 0;
  return $idx_m < sources_mtime() ? 1 : 0;
}

sub build_index {
  my $entries = load_all_entries();

  # Strip help from the index — it is loaded on demand for the matched few.
  # Leading + forces hashref (not a code block) inside map.
  my @slim = map { +{ %{$_}, help => undef } } @$entries;

  my $doc = {
    _generated => "$PROG index - regenerated automatically; do not edit or commit",
    version    => 1,
    entries    => \@slim,
  };

  my $idx  = index_path();
  my $json = JSON::PP->new->utf8(0)->canonical->pretty->encode($doc);
  open my $fh, '>:encoding(UTF-8)', $idx or die "$PROG: cannot write index $idx: $!\n";
  print {$fh} $json;
  close $fh;
  return scalar @slim;
} ## end sub build_index

# Return the index entries, rebuilding first if stale (or forced).
sub load_index {
  my (%opt) = @_;
  build_index() if $opt{force} || index_is_stale();
  my $doc = decode_file( index_path() );
  return $doc->{entries} || [];
}

# ------------------------------------------------------------------------------
# Status detection
# ------------------------------------------------------------------------------

# Does the (expanded) db path currently exist under $HOME?
sub path_exists {
  my ($entry) = @_;
  my $abs = expand_path( $entry->{path} );
  return ( -e $abs || -l $abs ) ? 1 : 0;
}

# Best-effort: is this path already redirected/handled by the repo?
#   env      -> handled when the named variable is set
#   alias    -> assumed handled (cannot verify a shell alias from here)
#   symlink  -> handled when the rewrite target exists
#   wrap     -> handled when the rewrite target exists (wrapper wiring is separate)
#   remove   -> a removal candidate, not "handled"
#   (none)   -> upstream-only: handling unknown
# Returns one of: handled / unhandled / remove / unknown.
sub handling_status {
  my ($entry) = @_;
  my $mech = $entry->{mechanism};
  return 'unknown' unless defined $mech;

  if ( $mech eq 'env' ) {

    # Handled when the env var is set (an exported redirect this shell sees),
    # or when the redirect target already exists — evidence of a redirect we
    # cannot see, e.g. a non-exported shell variable such as HISTFILE.
    my $by_env    = $entry->{env}     && $ENV{ $entry->{env} };
    my $by_target = $entry->{rewrite} && -e expand_path( $entry->{rewrite} );
    return ( $by_env || $by_target ) ? 'handled' : 'unhandled';
  }
  return 'handled' if $mech eq 'alias';
  if ( $mech eq 'symlink' || $mech eq 'wrap' ) {
    return ( $entry->{rewrite} && -e expand_path( $entry->{rewrite} ) ) ? 'handled' : 'unhandled';
  }
  return 'remove' if $mech eq 'remove';
  return 'unknown';
} ## end sub handling_status

# If the (expanded) path is a symlink, return its target, else undef. A
# symlinked dotfile is a deliberate managed link (e.g. into another repo), not
# a stray to migrate.
sub link_target {
  my ($entry) = @_;
  my $abs = expand_path( $entry->{path} );
  return -l $abs ? readlink($abs) : undef;
}

# Bucket an entry into a display group, or return undef to skip it (a file that
# is both absent and not redirected is simply irrelevant).
#   linked    : the path is a symlink (a deliberate managed link)
#   stray     : present + redirect active -> removable leftover
#   unhandled : present + not redirected (inactive mechanism, or no annotation)
#   remove    : mechanism = remove (unused app)
#   handled   : absent + redirect active -> already migrated/clean
sub classify {
  my ($entry) = @_;
  return 'linked' if defined link_target($entry);

  my $exists = path_exists($entry);
  my $status = handling_status($entry);

  if ( !$exists ) {
    return $status eq 'handled' ? 'handled' : undef;
  }
  return 'stray'  if $status eq 'handled';
  return 'remove' if $status eq 'remove';
  return 'unhandled';
}

# ------------------------------------------------------------------------------
# Mechanism state — the current (detected) mechanism vs the recommended
# (declared) one, plus the external owner. Layered over the signals above; the
# classify()/handling_status() vocabulary is unchanged.
# ------------------------------------------------------------------------------

# The external manager of a path, if any. An explicit overlay `owner` wins;
# otherwise a declared `mechanism: symlink` implies check-dotfiles (which owns
# the .dotlinks + `ln -fs` flow). Undef for everything else.
# A single-expression return (not a `return undef` statement) so an undef result
# stays a one-element list in the hash-value context this is called in — a bare
# `return;` there would collapse to an empty list and shift the surrounding hash.
sub effective_owner {
  my ($entry) = @_;
  return
      ( defined $entry->{owner} && length $entry->{owner} ) ? $entry->{owner}
    : ( ( $entry->{mechanism} // '' ) eq 'symlink' )        ? 'check-dotfiles'
    :                                                         undef;
}

# The dotlinks file check-dotfiles actually reads: $HOME/.dotlinks when present,
# else $DOTFILES/dotlinks-default. Undef when neither is readable (e.g. $DOTFILES
# unset). Mirrors check-dotfiles' own resolution — deliberately NOT the private
# set, which is a separate concern.
sub dotlinks_file {
  my $home = home_dir();
  my $user = File::Spec->catfile( $home, '.dotlinks' );
  return $user if -r $user;

  my $df = $ENV{DOTFILES};
  return unless defined $df && length $df;  # scalar/boolean caller: undef is fine
  my $def = File::Spec->catfile( $df, 'dotlinks-default' );
  return -r $def ? $def : undef;
}

# Is the entry's $HOME symlink one check-dotfiles maintains? True when a dotlinks
# line's link-name (its second field, else the source basename) equals the
# entry's $HOME dotfile name. A symlink present but NOT registered is a loose
# link check-dotfiles won't manage — a 'partial' setup.
sub dotlinks_registered {
  my ($entry) = @_;
  my $file = dotlinks_file() or return 0;

  ( my $want = expand_path( $entry->{path} ) ) =~ s{.*/}{};

  # Slurp then close (the read_file pattern) so the handle is released at once.
  open my $fh, '<:encoding(UTF-8)', $file or return 0;
  my @lines = <$fh>;
  close $fh;

  for my $line (@lines) {
    next if $line =~ /^\s*#/;
    $line         =~ s/\A\s+//;
    $line         =~ s/\s+\z//;
    next unless length $line;

    my ( $src, $name ) = split /\s+/, $line, 2;
    $name = ( defined $name && length $name ) ? $name : $src;
    $name =~ s{.*/}{};
    return 1 if $name eq $want;
  }
  return 0;
} ## end sub dotlinks_registered

# The mechanism currently handling this path, detected from $HOME state (with an
# honest 'unknown' fallback) — distinct from the *recommended* mechanism (the
# declared $entry->{mechanism}); the two are compared for a divergence report.
#   symlink   : the $HOME path is a symlink (structurally detectable)
#   env       : an env redirect is declared AND active (var set / target exists)
#   hardcoded : present real file, no detectable redirect, not a symlink — the
#               unmanaged state we migrate away from
#   absent    : not present (and no active env redirect)
#   unknown   : present but handled by a mechanism Phase 1 cannot verify from a
#               child process (alias/wrap), or otherwise inconclusive
sub current_mechanism {
  my ($entry) = @_;
  return 'symlink' if defined link_target($entry);

  my $mech   = $entry->{mechanism} // '';
  my $exists = path_exists($entry);

  # A symlink-recommended path presently redirected by its declared (exported)
  # env var — an env->symlink conversion candidate (Slice 2). A non-exported
  # redirect is invisible to a child process and falls through to hardcoded/
  # absent below (the documented same-child-process limitation).
  return 'env'
    if $mech eq 'symlink' && $entry->{env} && length( $ENV{ $entry->{env} } // '' );

  if ( $mech eq 'env' ) {
    return 'env' if handling_status($entry) eq 'handled';
    return $exists ? 'hardcoded' : 'absent';
  }

  return 'absent' unless $exists;

  # Present, real, not a symlink. An alias/wrap redirect can't be confirmed from
  # a child process, so those stay 'unknown'; everything else — no annotation,
  # 'remove', or a 'symlink' recommendation not realised as a link — is the
  # unmanaged 'hardcoded' state.
  #
  # ICEBOX: alias/wrap current-mechanism detection (installation-method
  # detection, `bin/where` classification, `type -t`, aliased command, wrapper
  # on PATH) is Phase 3 of ADR-0004 and is ICEBOXED (2026-07-22) — near-zero
  # demand (1 alias entry, 0 wrap) + no command field in the schema + the
  # shell-context (bash -ic) constraint. Revisit only on a real alias/wrap
  # entry. See docs/adr/0004 *Phase 3 status*.
  return 'unknown' if $mech eq 'alias' || $mech eq 'wrap';
  return 'hardcoded';
} ## end sub current_mechanism

# The completeness sub-state of the current mechanism, or undef when it has
# none. A symlink is 'complete' when registered in the dotlinks file, else
# 'partial'; an env redirect is 'leftover' when a $HOME copy remains, else
# 'clean'.
sub current_completeness {
  my ( $entry, $cur ) = @_;
  $cur //= current_mechanism($entry);

  # A single-expression return (see effective_owner) so an undef completeness
  # stays a one-element list in its hash-value call site.
  return
      $cur eq 'symlink' ? ( dotlinks_registered($entry) ? 'complete' : 'partial' )
    : $cur eq 'env'     ? ( path_exists($entry) ? 'leftover' : 'clean' )
    :                     undef;
}

# A short recommended-vs-actual verdict for the reports: "using recommended"
# when they agree, "using X, recommended Y" when they differ, and the bare
# state for unknown/absent (nothing installed to compare).
sub divergence_flag {
  my ( $cur, $rec ) = @_;
  return 'unknown' if $cur eq 'unknown';
  return 'absent'  if $cur eq 'absent';

  my $have_rec = defined $rec && length $rec;
  return 'using recommended' if $have_rec && $cur eq $rec;
  return "using $cur, recommended $rec" if $have_rec;
  return "using $cur";
}

# Assemble a report record for one entry.
sub report_record {
  my ($entry) = @_;
  my $link    = link_target($entry);
  my $cur     = current_mechanism($entry);
  return {
    name                  => $entry->{name},
    source                => $entry->{source},
    path                  => $entry->{path},
    display               => home_relative( $entry->{path} ),
    resolved              => expand_path( $entry->{path} ),
    exists                => ( path_exists($entry) ? JSON::PP::true : JSON::PP::false ),
    movable               => ( $entry->{movable}   ? JSON::PP::true : JSON::PP::false ),
    mechanism             => $entry->{mechanism},
    env                   => $entry->{env},
    rewrite               => $entry->{rewrite},
    reason                => $entry->{reason},
    link_target           => $link,
    status                => ( defined $link ? 'linked' : handling_status($entry) ),
    group                 => classify($entry),
    current_mechanism     => $cur,
    current_completeness  => current_completeness( $entry, $cur ),
    recommended_mechanism => $entry->{mechanism},
    divergence            => divergence_flag( $cur, $entry->{mechanism} ),
    owner                 => effective_owner($entry),
    suggested_steps       => suggested_steps($entry),
  };
} ## end sub report_record

# ------------------------------------------------------------------------------
# Output
# ------------------------------------------------------------------------------

sub emit_json {
  my ($data) = @_;
  print JSON::PP->new->utf8(0)->canonical->pretty->encode($data);
  return;
}

# Usable terminal width: $COLUMNS, else the tty size, else 80.
sub term_width {
  return $ENV{COLUMNS} if $ENV{COLUMNS} && $ENV{COLUMNS} =~ /^\d+$/;

  # struct winsize is 4 unsigned shorts (rows, cols, ...); TIOCGWINSZ=0x5413.
  my $ws = pack 'S4', 0, 0, 0, 0;
  if ( ioctl( STDOUT, 0x5413, $ws ) ) {
    my ( undef, $cols ) = unpack 'S4', $ws;
    return $cols if $cols;
  }
  return 80;
}

# Drop the assumed $HOME/ prefix from a db path ($HOME/.foo -> .foo). The scan
# only covers $HOME, so the prefix is noise.
sub home_relative {
  my ($path) = @_;
  $path =~ s{^\$\{?HOME\}?/}{};
  return $path;
}

# Default-scan groups: only the actionable ones. The non-actionable groups
# (handled, ignored, linked) are shown only with -a/--all (print_scan_all).
my @GROUP_ORDER = qw(unhandled stray remove);

# Print the actionable classified records grouped by type, in GROUP_ORDER,
# omitting empty groups. Each row is a terse "appname (.dotfile)".
sub print_grouped {
  my ($buckets) = @_;

  my @shown = grep { $buckets->{$_} && @{ $buckets->{$_} } } @GROUP_ORDER;

  unless (@shown) {
    print "Nothing to report.\n";
    return;
  }

  my $first = 1;
  for my $group (@shown) {
    print "\n" unless $first;
    $first = 0;
    print "$group\n";

    for my $r ( sort { $a->{name} cmp $b->{name} || $a->{path} cmp $b->{path} } @{ $buckets->{$group} } ) {
      printf "  %s (%s)\n", $r->{name}, $r->{display};
    }
  }
  return;
} ## end sub print_grouped

# --all display order: the non-actionable groups first (handled, ignored,
# linked), then the actionable ones.
my @ALL_ORDER = qw(handled ignored linked unhandled stray remove unknown);

# The mechanism/type tag shown after an entry in the --all view. A symlink is
# "external"; an annotated redirect shows its mechanism (env/alias/...); an
# ignored path shows "ignore"; a mechanism-less path our overlay adds shows
# "overlay"; a plain upstream entry with nothing to add gets no tag.
sub scan_tag {
  my ($r) = @_;
  return 'external'      if defined $r->{link_target};
  return $r->{mechanism} if defined $r->{mechanism};
  return 'ignore'        if ( $r->{group}  // '' ) eq 'ignored';
  return 'overlay'       if ( $r->{source} // '' ) =~ /^(?:override|local)$/;
  return;
}

# --all renderer: like print_grouped, but adds the handled + ignored groups,
# tags every entry with its mechanism, and collapses an app's dotfiles onto one
# line. Symlinks stay one-per-line (each has its own target).
sub print_scan_all {
  my ($buckets) = @_;

  my @shown = grep { $buckets->{$_} && @{ $buckets->{$_} } } @ALL_ORDER;
  unless (@shown) {
    print "Nothing to report.\n";
    return;
  }

  my $first = 1;
  for my $group (@shown) {
    print "\n" unless $first;
    $first = 0;
    print "$group\n";

    if ( $group eq 'linked' ) {
      print_external_rows( $buckets->{$group} );
    } elsif ( $group eq 'unknown' ) {
      print_unknown_rows( $buckets->{$group} );
    } else {
      print_collapsed_rows( $buckets->{$group} );
    }
  }
  return;
} ## end sub print_scan_all

# Symlink rows: "app (.x)  -> target (external)", targets aligned (width-aware).
sub print_external_rows {
  my ($rows) = @_;

  my @sorted = sort { $a->{name} cmp $b->{name} || $a->{path} cmp $b->{path} } @$rows;
  my $w      = 0;
  for my $r (@sorted) {
    my $len = length sprintf( '%s (%s)', $r->{name}, $r->{display} );
    $w = $len if $len > $w;
  }
  my $cap = term_width() - 42;
  $w = $cap if $cap > 12 && $w > $cap;

  for my $r (@sorted) {
    my $left = sprintf '%s (%s)', $r->{name}, $r->{display};
    printf "  %-*s  -> %s (external)\n", $w, $left, ( $r->{link_target} // '?' );
  }
  return;
} ## end sub print_external_rows

# Collapse an app's dotfiles that share a tag (and reason) into
# "app (.a,.b) (tag) - reason". Only ignored entries carry a reason.
sub print_collapsed_rows {
  my ($rows) = @_;

  my ( %agg, @order );
  for my $r (@$rows) {
    my $tag    = scan_tag($r) // q{};
    my $reason = $r->{reason} // q{};
    my $key    = join "\0", $r->{name}, $tag, $reason;
    if ( !$agg{$key} ) {
      $agg{$key} = { name => $r->{name}, tag => $tag, reason => $reason, dots => [] };
      push @order, $key;
    }
    push @{ $agg{$key}{dots} }, $r->{display};
  }

  my @lines = sort { $a->{name} cmp $b->{name} || $a->{tag} cmp $b->{tag} }
    map { $agg{$_} } @order;

  for my $l (@lines) {
    my $line = sprintf '%s (%s)', $l->{name}, join( ',', sort @{ $l->{dots} } );
    $line .= " ($l->{tag})"    if length $l->{tag};
    $line .= " - $l->{reason}" if length $l->{reason};
    print "  $line\n";
  }
  return;
} ## end sub print_collapsed_rows

# 'unknown' rows: a $HOME dotfile with no owning app. Just the name (+ target if
# it is a symlink) — there is no app or mechanism to show.
sub print_unknown_rows {
  my ($rows) = @_;

  my @sorted = sort { $a->{display} cmp $b->{display} } @$rows;
  my $w      = 0;
  for my $r (@sorted) { $w = length $r->{display} if length $r->{display} > $w }

  for my $r (@sorted) {
    if ( defined $r->{link_target} ) {
      printf "  %-*s  -> %s\n", $w, $r->{display}, $r->{link_target};
    } else {
      printf "  %s\n", $r->{display};
    }
  }
  return;
}

# ------------------------------------------------------------------------------
# Detail view (single app / path lookup)
# ------------------------------------------------------------------------------

sub print_app_detail {
  my ($entries) = @_;
  my $app = @$entries ? $entries->[0]{name} : '(unknown)';

  # Show every path — including ignored ones — so the app's full picture is
  # visible. Ignored paths are marked (they are left in place by choice).
  my @out;
  for my $e (@$entries) {
    my $exists = path_exists($e);
    my $link   = link_target($e);
    my $cur    = current_mechanism($e);
    push @out, {
      name                  => $e->{name},
      source                => $e->{source},
      path                  => home_relative( $e->{path} ),
      exists                => ( $exists ? JSON::PP::true : JSON::PP::false ),
      movable               => $e->{movable},
      mechanism             => $e->{mechanism},
      env                   => $e->{env},
      rewrite               => $e->{rewrite},
      link_target           => $link,
      reason                => $e->{reason},
      ignore                => ( $e->{ignore}  ? JSON::PP::true : JSON::PP::false ),
      group                 => ( $e->{ignore}  ? 'ignore'       : classify($e) ),
      status                => ( defined $link ? 'linked'       : $exists ? handling_status($e) : 'not present' ),
      current_mechanism     => $cur,
      current_completeness  => current_completeness( $e, $cur ),
      recommended_mechanism => $e->{mechanism},
      divergence            => divergence_flag( $cur, $e->{mechanism} ),
      owner                 => effective_owner($e),
      suggested_steps       => suggested_steps($e),
      help                  => $e->{help},
    };
  } ## end for my $e (@$entries)

  if ( $cli{json} ) {
    emit_json( { app => $app, files => \@out } );
    return;
  }

  # Paths block: one line per path, $HOME stripped, detail depends on type.
  print "$out[0]{name}  ($out[0]{source})\n\n";
  my $w = 0;
  for my $f (@out) { $w = length $f->{path} if length $f->{path} > $w }

  for my $f (@out) {
    my $ignored = 'ignored (left in place)' . ( $f->{reason} ? " - $f->{reason}" : q{} );
    my $detail =
        $f->{ignore}                                             ? $ignored
      : defined $f->{link_target}                                ? "-> $f->{link_target}"
      : !$f->{exists} && $f->{group} && $f->{group} eq 'handled' ? 'handled'
      : !$f->{exists}                                            ? 'absent'
      :                                                            $f->{group};

    # Surface the recommended mechanism when the current one diverges from it
    # ("this should be a symlink but isn't"), and the external owner when set.
    # Aligned or unannotated paths append nothing, so the group word still
    # leads the line.
    my ( $cur, $rec ) = ( $f->{current_mechanism}, $f->{recommended_mechanism} );
    if ( !$f->{ignore} && defined $rec && length $rec && defined $cur && $cur ne $rec ) {
      $detail .= " (recommended: $rec)";
    }
    $detail .= " [owner: $f->{owner}]" if $f->{owner};

    printf "  %-*s  %s\n", $w, $f->{path}, $detail;
  } ## end for my $f (@out)

  # Then each path's migration help (ignored paths need none).
  for my $f (@out) {
    next if $f->{ignore};
    next unless defined $f->{help};
    my $help = $f->{help};
    $help =~ s/\n+\z//;
    $help =~ s/^(?=.)/    /mg;         # indent non-empty lines only
    print "\nhelp for $f->{path}:\n$help\n";
  }
  return;
} ## end sub print_app_detail

# ------------------------------------------------------------------------------
# Modes
# ------------------------------------------------------------------------------

# $HOME top-level dotfiles that no db path covers. The XDG base dirs
# (.config/.cache/.local) are infrastructure, not migration candidates, so they
# are skipped. Returns 'unknown' records (present, no owning app).
sub scan_unknown {
  my ($known) = @_;

  my $home = home_dir();
  opendir my $dh, $home or return ();
  my %skip = map { $_ => 1 } qw(. .. .config .cache .local);

  my @recs;
  for my $name ( readdir $dh ) {
    next unless $name =~ /^\./;
    next if $skip{$name};

    my $abs = File::Spec->catfile( $home, $name );
    next if $known->{$abs};

    my $link = -l $abs ? readlink($abs) : undef;
    push @recs, {
      name                  => q{},
      path                  => $abs,
      display               => $name,
      resolved              => $abs,
      exists                => JSON::PP::true,
      movable               => JSON::PP::false,
      mechanism             => undef,
      source                => undef,
      reason                => undef,
      link_target           => $link,
      status                => 'unknown',
      group                 => 'unknown',
      current_mechanism     => ( defined $link ? 'symlink' : 'unknown' ),
      current_completeness  => undef,
      recommended_mechanism => undef,
      divergence            => ( defined $link ? 'using symlink' : 'unknown' ),
      owner                 => undef,
    };
  } ## end for my $name ( readdir ...)
  closedir $dh;
  return @recs;
} ## end sub scan_unknown

sub mode_scan {
  my $entries = load_index( force => $cli{reindex} );

  # Every db path (files + ignores) is "known"; a $HOME dotfile outside this set
  # is surfaced as 'unknown' below.
  my %known = map { expand_path( $_->{path} ) => 1 } @$entries;

  my ( @records, %buckets );
  for my $e (@$entries) {
    next if defined $cli{mechanism} && ( $e->{mechanism} // '' ) ne $cli{mechanism};
    next if defined $cli{movable}   && ( ( $e->{movable} ? 1 : 0 ) != $cli{movable} );

    my ( $group, $rec );
    if ( $e->{ignore} ) {

      # Deliberately-left-in-place paths: their own group, shown only with -a.
      # Skip when absent — nothing is left in place if the file isn't there.
      next unless path_exists($e);
      $group        = 'ignored';
      $rec          = report_record($e);
      $rec->{group} = $rec->{status} = 'ignored';
    } else {
      $group = classify($e);
      next unless defined $group;      # absent and not redirected -> irrelevant
      $rec = report_record($e);
    }

    push @records,              $rec;
    push @{ $buckets{$group} }, $rec;
  } ## end for my $e (@$entries)

  # $HOME dotfiles no db entry (upstream or overlay) covers -> 'unknown'.
  for my $rec ( scan_unknown( \%known ) ) {
    push @records,               $rec;
    push @{ $buckets{unknown} }, $rec;
  }

  if ( $cli{json} ) {

    # A flat feed: every classified record (handled and ignored included)
    # carries its group, so tooling gets the full picture regardless of --all.
    emit_json( \@records );
  } elsif ( $cli{all} ) {
    print_scan_all( \%buckets );
  } else {
    print_grouped( \%buckets );
  }

  # Exit 2 when there is actionable work; 0 when only handled/linked/ignored.
  my $actionable = grep { $buckets{$_} && @{ $buckets{$_} } } qw(unhandled stray remove);
  return $actionable ? 2 : 0;
} ## end sub mode_scan

# Look up by a $HOME path, an exact app name, or a name fragment.
#   - a path-ish query matches by owned path;
#   - an EXACT app name wins, so `bash` / `docker` show their own detail rather
#     than a fragment list (babashka, docker-machine, ...);
#   - otherwise a fragment resolves by ambiguity: one app -> detail, several ->
#     a per-app list (so `Vim`, which is no app's exact name, still lists the
#     vim family).
sub mode_lookup {
  my ($query) = @_;

  if ( $query =~ m{/} || $query =~ /^\./ ) {
    return resolve_and_show( [ find_by_path($query) ], $query );
  }

  my $exact = load_app($query);
  if ($exact) {
    print_app_detail($exact);
    return 0;
  }

  return resolve_and_show( [ find_by_name($query) ], $query );
}

# Entries whose owned path matches the query (exact, expanded, or substring).
sub find_by_path {
  my ($query) = @_;
  my $entries = load_index( force => $cli{reindex} );
  my $qexp    = expand_path($query);
  return grep {
    my $p  = $_->{path};
    my $pe = expand_path($p);
    $p eq $query || $pe eq $qexp || $p =~ /\Q$query\E/ || $pe =~ /\Q$qexp\E/;
  } @$entries;
}

# Entries whose app name or (home-relative) path matches a fragment. A direct
# lookup surfaces ignored entries too (the detail view then notes they are left
# in place); only the scan suppresses them.
sub find_by_name {
  my ($term)  = @_;
  my $entries = load_index( force => $cli{reindex} );
  my $re      = qr/\Q$term\E/i;
  return grep { $_->{name} =~ $re || home_relative( $_->{path} ) =~ $re } @$entries;
}

# One distinct app → its detail; none → no-match; several → a per-app list.
sub resolve_and_show {
  my ( $hits, $query ) = @_;
  my %apps;
  $apps{ $_->{name} } = 1 for @$hits;
  my @names = sort keys %apps;

  if ( @names == 1 ) {
    print_app_detail( load_app( $names[0] ) );
    return 0;
  }
  if ( !@names ) {
    if ( $cli{json} ) { emit_json( { query => $query, matches => [] } ); }
    else              { print "No known program matches '$query'.\n"; }
    return 1;
  }
  print_matches( $hits, $query );
  return 0;
} ## end sub resolve_and_show

# List the distinct apps that matched, each with its matching dotfile(s).
sub print_matches {
  my ( $hits, $term ) = @_;
  my %by;
  push @{ $by{ $_->{name} } }, home_relative( $_->{path} ) for @$hits;

  if ( $cli{json} ) {
    my @m = map { { name => $_, paths => $by{$_} } } sort keys %by;
    emit_json( { query => $term, matches => \@m } );
    return;
  }

  my $header = ( keys %by > 1 ) ? "Multiple apps match '$term':" : "Matches for '$term':";
  print "$header\n";
  for my $name ( sort keys %by ) {
    printf "  %-22s %s\n", $name, join( ', ', @{ $by{$name} } );
  }
  return;
} ## end sub print_matches

# Explicit --search: broadest match (name / path / help), always a per-app list.
sub mode_search {
  my ($term)  = @_;
  my $entries = load_all_entries();    # search scans help → load bodies
  my $re      = qr/\Q$term\E/i;

  my @hits = grep {
    ( join "\n", grep { defined } $_->{name}, $_->{path}, $_->{help} ) =~ $re;
  } @$entries;

  unless (@hits) {
    if ( $cli{json} ) { emit_json( { query => $term, matches => [] } ); }
    else              { print "No matches for '$term'.\n"; }
    return 1;
  }

  print_matches( \@hits, $term );
  return 0;
} ## end sub mode_search

# ------------------------------------------------------------------------------
# Removal (guarded $HOME mutation)
# ------------------------------------------------------------------------------

# Resolve a --remove target (app name or $HOME path) to its path entries,
# reusing the lookup resolution: a path-ish query maps by owned path, an exact
# app name loads that app, and otherwise a name fragment resolves by
# find_by_name (the caller refuses an ambiguous multi-app match).
sub resolve_target_entries {
  my ($query) = @_;

  return find_by_path($query) if $query =~ m{/} || $query =~ /^\./;

  my $exact = load_app($query);
  return @$exact if $exact;

  return find_by_name($query);
}

# Resolve a mutation target to the entries of exactly ONE app, or print the
# no-match / ambiguity message and return an empty list. Shared by --migrate and
# --fix so a mutation is never run against a fragment that spans several apps.
# $verb names the mode in the ambiguity hint (e.g. '--migrate env').
sub resolve_one_app {
  my ( $query, $verb ) = @_;

  my @entries = resolve_target_entries($query);
  unless (@entries) {
    print "No known program or path matches '$query'.\n";
    return;
  }

  my %apps = map { $_->{name} => 1 } @entries;
  if ( keys %apps > 1 ) {
    print_matches( \@entries, $query );
    print "\nName one app (or a specific \$HOME path) to $verb.\n";
    return;
  }

  return @entries;
} ## end sub resolve_one_app

# Prompt on STDIN, defaulting to No; returns true only on an explicit yes.
sub prompt_yes {
  my ($msg) = @_;
  local $| = 1;
  print $msg;

  # An interactive confirmation must read the terminal, so STDIN is deliberate.
  my $ans = <STDIN>; ## no critic (InputOutput::ProhibitExplicitStdin)
  return defined $ans && $ans =~ /\A\s*y(?:es)?\s*\z/i ? 1 : 0;
}

# Delete a regular file, or a directory tree. Returns true on success.
sub remove_path {
  my ($abs) = @_;

  if ( -d $abs && !-l $abs ) {
    require File::Path;
    my $err;
    File::Path::remove_tree( $abs, { error => \$err } );
    return ( $err && @$err ) ? 0 : 1;
  }
  return unlink($abs) ? 1 : 0;
}

# Tear down a check-dotfiles-managed symlink: unlink ~/.x and drop its dotlinks
# line (so check-dotfiles won't recreate it). The canonical repo file is LEFT
# INTACT — only the link and its registration go. Recreates the link if the
# dotlinks edit fails (the file itself is restored by remove_dotlinks_line).
# Returns (ok, message).
sub teardown_symlink {
  my ( $abs, $dl ) = @_;

  ( my $linkname = $abs ) =~ s{.*/}{};
  my $link_text = readlink($abs);

  return ( 0, "could not remove the symlink $abs: $!" )
    unless unlink $abs;

  my ( $ok, $err ) = remove_dotlinks_line( $dl, $linkname );
  unless ($ok) {
    symlink( $link_text, $abs );       # recreate the link on rollback
    return ( 0, "could not update $dl ($err) - reverted (symlink restored)" );
  }

  return ( 1, "removed the symlink $abs and its dotlinks entry in $dl (repo file left intact)" );
}

# --remove <app|$HOME-path>: delete a confirmed leftover, or tear down a managed
# symlink. Eligible: a 'stray' (present, redirect active AND its target exists —
# a stray whose redirect target was never created is refused, since the $HOME
# copy would be the only one) or a 'remove'-mechanism (unused app) file; a
# check-dotfiles-managed (registered) symlink is TORN DOWN (link + its dotlinks
# entry dropped, the repo file kept). A loose/external symlink or an
# un-redirected file is refused. Every change is confined to $HOME and confirmed
# interactively (default No). Never scan-wide — the target must be named.
sub mode_remove {
  my ($query) = @_;

  unless ( defined $query && length $query ) {
    print {*STDERR} "$PROG: --remove needs an app name or \$HOME path\n";
    return 1;
  }

  my @entries = resolve_target_entries($query);
  unless (@entries) {
    print "No known program or path matches '$query'.\n";
    return 1;
  }

  # A mutation must be unambiguous: refuse a fragment spanning several apps.
  my %apps = map { $_->{name} => 1 } @entries;
  if ( keys %apps > 1 ) {
    print_matches( \@entries, $query );
    print "\nName one app (or a specific \$HOME path) to --remove.\n";
    return 1;
  }

  my $home = home_dir();
  print "$entries[0]{name}\n\n";

  # First pass: show every path's disposition and collect the eligible actions
  # (a plain 'delete' of a leftover, or a symlink 'teardown'). Prompting in a
  # second pass keeps the status block from interleaving with the confirmation
  # prompts when an app owns several paths.
  my @actions;
  for my $e ( sort { $a->{path} cmp $b->{path} } @entries ) {
    my $abs  = expand_path( $e->{path} );
    my $disp = home_relative( $e->{path} );

    if ( $e->{ignore} ) {
      printf "  %-24s ignored (left in place)\n", $disp;
      next;
    }

    my $group = classify($e) // ( path_exists($e) ? 'unhandled' : 'absent' );

    # A symlink: tear down only a check-dotfiles-managed (registered) link; a
    # loose or external link is refused — we unlink only what we understand and
    # never touch the canonical repo file.
    if ( $group eq 'linked' ) {
      my $dl = dotlinks_file();
      if ( defined $dl && dotlinks_registered($e) ) {
        printf "  %-24s linked (check-dotfiles) - drop the link + its dotlinks entry (repo file %s kept)\n",
          $disp, ( link_target($e) // '' );
        push @actions, { type => 'teardown', abs => $abs, dl => $dl };
      } else {
        printf "  %-24s linked (external / not check-dotfiles-managed) - not removed (use --fix to register a loose link)\n",
          $disp;
      }
      next;
    }

    if ( $group eq 'unhandled' ) {
      printf "  %-24s unhandled - migrate it first (not a removal)\n", $disp;
      next;
    }
    if ( $group ne 'stray' && $group ne 'remove' ) {
      printf "  %-24s %s - nothing to remove\n", $disp, $group;
      next;
    }

    # A 'stray' is only safe to delete when its redirect target actually exists;
    # otherwise the $HOME copy is the ONLY copy (the env var is set but the
    # redirected file was never created) — migrate it, don't delete it. A
    # 'remove'-marked file (an unused app) has no target and is exempt.
    if ( $group eq 'stray' ) {
      my $tgt = $e->{rewrite} ? expand_path( $e->{rewrite} ) : undef;
      unless ( defined $tgt && -e $tgt ) {
        printf "  %-24s stray, but its redirect target %s does not exist - migrate it (--migrate env), don't delete\n",
          $disp, ( defined $tgt ? $tgt : '(none declared)' );
        next;
      }
    }

    # Eligible leftover — but never delete outside $HOME.
    unless ( index( $abs, "$home/" ) == 0 ) {
      printf "  %-24s resolves outside \$HOME (%s) - refused\n", $disp, $abs;
      next;
    }

    my $kind = ( -d $abs && !-l $abs ) ? 'directory' : 'file';
    printf "  %-24s %s - a leftover %s\n", $disp, $group, $kind;
    push @actions, { type => 'delete', abs => $abs };
  } ## end for my $e ( sort { $a->...})

  # Second pass: confirm and perform each action (default No).
  my $removed = 0;
  if (@actions) {
    print "\n";
    for my $a (@actions) {
      if ( $a->{type} eq 'teardown' ) {
        next
          unless prompt_yes("  Remove the symlink $a->{abs} and its dotlinks entry (the repo file stays)? [y/N] ");

        my ( $ok, $msg ) = teardown_symlink( $a->{abs}, $a->{dl} );
        if ($ok) {
  print "  $msg\n";
  $removed++;
        } else {
  print {*STDERR} "  $PROG: $msg\n";
        }
        next;
      }

      next unless prompt_yes("  Delete $a->{abs}? [y/N] ");

      if ( remove_path( $a->{abs} ) ) {
        print "  removed $a->{abs}\n";
        $removed++;
      } else {
        print {*STDERR} "  $PROG: could not remove $a->{abs}: $!\n";
      }
    } ## end for my $a (@actions)
  } ## end if (@actions)

  print "\n$PROG: removed $removed item(s).\n";
  return 0;
} ## end sub mode_remove

# ------------------------------------------------------------------------------
# Migration (guarded $HOME -> XDG move)
# ------------------------------------------------------------------------------

# Move a file (or directory) from $abs to $tgt, creating the target's parent.
# A file uses File::Copy::move, which handles a cross-filesystem move (copy +
# unlink). A directory is moved with a same-filesystem rename only; a
# cross-device directory move is refused rather than risking a half-copy (a
# recursive copy would need a non-core module, and this script is core-only).
#
# ICEBOX: supporting a cross-filesystem (EXDEV) DIRECTORY move — via an `mv`
# shell-out or a core recursive-copy strategy — is deferred until a real case
# appears. None has: jbang (the cited 471M ~/.jbang candidate) migrated
# same-filesystem (instant rename). Revisit only on a genuine cross-device
# directory-migration case.
#
# Returns (ok, err): ok truthy on success, else err is a human message.
sub move_path {
  my ( $abs, $tgt ) = @_;

  require File::Basename;
  my $parent = File::Basename::dirname($tgt);
  if ( length $parent && !-d $parent ) {
    require File::Path;
    File::Path::make_path($parent);
    return ( 0, "could not create $parent: $!" ) unless -d $parent;
  }

  if ( -d $abs && !-l $abs ) {
    return ( 1, undef ) if rename $abs, $tgt;

    # Capture errno *before* anything else runs — require/make_path/etc. would
    # clobber $! with their own syscalls, so a deferred check would miss EXDEV.
    my $errno = $!;
    require Errno;
    return ( 0, 'cross-filesystem directory move - move it by hand' )
      if $errno == Errno::EXDEV();
    return ( 0, "could not move directory: $errno" );
  }

  require File::Copy;
  return File::Copy::move( $abs, $tgt ) ? ( 1, undef ) : ( 0, "could not move: $!" );
} ## end sub move_path

# ICEBOX: an "ephemeral-cache relocator" — a standalone helper (separate from
# xdg-audit) that symlinks an app's cache dir to $XDG_CACHE_HOME /
# $XDG_RUNTIME_DIR with a dry-run + env-config, for chromium/electron-style
# caches — is a considered "not now": build only when a SECOND real case
# appears (one case does not justify the generic tool). Revisit then.

# --migrate <mechanism> <app|$HOME-path>: transition the target to <mechanism>.
# The mechanism is a REQUIRED positional (no silent default). `env` and
# `symlink` are implemented; the rest arrive in later phases (see ADR-0004).
# mode_migrate validates the mechanism + target and dispatches to the
# per-mechanism executor. Every change is confirmed interactively (default No);
# never scan-wide.
sub mode_migrate {
  my ( $mechanism, $query ) = @_;

  unless ( defined $mechanism && length $mechanism ) {
    print {*STDERR} "$PROG: --migrate needs a target mechanism and an app|\$HOME path (e.g. --migrate env bash)\n";
    return 1;
  }

  # env/symlink/recommended are implemented. Reject anything else — a planned-
  # but-unbuilt mechanism, or the old bare `--migrate <app>` syntax where the
  # app name lands here as the mechanism — with a message that teaches the new
  # signature rather than silently mis-reading the app as a mechanism.
  my %supported = ( env => 1, symlink => 1, recommended => 1 );
  unless ( $supported{$mechanism} ) {
    print {*STDERR} "$PROG: --migrate takes a target mechanism first: --migrate <mechanism> <app|\$HOME path>.\n"
      . "  Implemented mechanisms are 'env', 'symlink', and 'recommended' (e.g. --migrate env bash); '$mechanism' is not one.\n";
    return 1;
  }

  unless ( defined $query && length $query ) {
    print {*STDERR} "$PROG: --migrate $mechanism needs an app name or \$HOME path\n";
    return 1;
  }

  return mode_migrate_recommended($query) if $mechanism eq 'recommended';
  return mode_migrate_env($query)         if $mechanism eq 'env';
  return mode_migrate_symlink($query)     if $mechanism eq 'symlink';
  return 1;                            # unreachable: %supported gates the mechanism above
} ## end sub mode_migrate

# --migrate recommended: resolve the target's declared (recommended) mechanism
# and dispatch to that mechanism's transition. An app must resolve to a single
# recommended mechanism (env/symlink); a heterogeneous app, an unimplementable
# recommendation (alias/wrap/remove), or a mechanism-less entry is refused with
# a message. Name a single $HOME path to pin one mechanism.
sub mode_migrate_recommended {
  my ($query) = @_;

  my @entries = resolve_one_app( $query, '--migrate recommended' ) or return 1;

  my ( $mech, $err ) = resolve_recommended_mechanism( \@entries );
  if ( defined $err ) {
    print {*STDERR} "$PROG: $err\n";
    return 1;
  }

  # The resolver only ever yields an implemented target; re-passing $query lets
  # the chosen executor re-resolve (cheap, idempotent) and run unchanged.
  return mode_migrate_env($query)     if $mech eq 'env';
  return mode_migrate_symlink($query) if $mech eq 'symlink';
  return 1;                            # unreachable: resolver returns only env/symlink
}

# Resolve the single recommended mechanism for an app's entries, or an error.
# Returns ($mech, undef) when exactly one implementable mechanism is declared
# across the non-ignored entries, else (undef, message). alias/wrap/remove are
# not `--migrate` targets; several distinct mechanisms are ambiguous.
#
# ICEBOX: alias/wrap as --migrate targets (the alias/wrap transition cells,
# the full N×N mechanism matrix, instruct-the-alias-line, and the bin/<app>
# self-wrap tier — a `mechanism: wrap` wrapper via `unshare --user
# --map-root-user --mount` + `mount --bind`, an `xdg-audit --wrap <app>`
# scaffold, and a global rules/<wrap-mechanism>.md, for apps that hardcode
# paths with no env var like Java/Maven/cpan) are Phase 3 of ADR-0004 and are
# ICEBOXED (2026-07-22) — near-zero demand (1 alias entry, 0 wrap across the
# corpus). Revisit only on real alias/wrap entries or a decision to build the
# self-wrap tier. See docs/adr/0004 *Phase 3 status*.
sub resolve_recommended_mechanism {
  my ($entries) = @_;
  my $name = $entries->[0]{name};

  my @named = grep { !$_->{ignore} && defined $_->{mechanism} && length $_->{mechanism} } @$entries;
  my %seen  = map  { $_->{mechanism} => 1 } @named;
  my @mechs = sort keys %seen;

  return ( undef, "no recommended mechanism is declared for $name (add an overlay 'mechanism') - nothing to resolve" )
    unless @mechs;

  if ( @mechs > 1 ) {
    my $breakdown = join "\n",
      map { sprintf "    %-24s %s", home_relative( $_->{path} ), $_->{mechanism} }
      sort { $a->{path} cmp $b->{path} } @named;
    return (
      undef,
      "$name owns paths with different recommended mechanisms:\n$breakdown\n"
        . "  run --migrate <mechanism> $name per mechanism, or name a single \$HOME path"
    );
  }

  my $only = $mechs[0];
  return ( $only, undef ) if $only eq 'env' || $only eq 'symlink';
  return (
    undef,
    "the recommended mechanism for $name is '$only', which --migrate cannot yet perform"
      . " (alias/wrap are iceboxed, remove is via --remove - see ADR-0004 Phase 3 status)"
  );
} ## end sub resolve_recommended_mechanism

# The exact shell line that activates an entry's env redirect, or undef when the
# entry lacks the variable or rewrite. The declared `rewrite` token is written
# verbatim in double quotes so the user's shell expands it (portable, ready to
# paste), e.g. export LESSHISTFILE="$XDG_STATE_HOME/less/history".
sub env_export_command {
  my ($entry) = @_;
  return unless $entry->{env} && $entry->{rewrite};
  return qq{export $entry->{env}="$entry->{rewrite}"};
}

# The shell line that tears down an entry's env redirect (the env->symlink
# sibling of env_export_command). `unset` clears the live shell; the note tells
# the user to also delete the persistent `export` line. Undef without an `env`.
sub env_unset_command {
  my ($entry) = @_;
  return unless $entry->{env};
  return "unset $entry->{env}";
}

# The dual-audience "instruct the rest" steps for an entry, as structured data
# for --json (the human sibling is printed by the mutating modes). Two shapes,
# both runtime-computed (they depend on live $ENV / fs state):
#   * an 'export' step — the redirect a hardcoded/symlink-current env-recommended
#     path needs to become env (Slice 1, broadened to the symlink-current case);
#   * a 'remove-export' step — the export a symlink-recommended path currently
#     redirected by env must drop when it converts to a symlink (Slice 2).
sub suggested_steps {
  my ($entry) = @_;

  my $mech = $entry->{mechanism} // '';
  my $cur  = current_mechanism($entry);

  if ( $mech eq 'env' && $entry->{env} && $entry->{rewrite} && ( $cur eq 'hardcoded' || $cur eq 'symlink' ) ) {
    return [
      { mechanism => 'env',
        action    => 'export',
        variable  => $entry->{env},
        value     => $entry->{rewrite},
        resolved  => expand_path( $entry->{rewrite} ),
        command   => env_export_command($entry),
        note      => "add to your shell config before running $entry->{name} again",
      } ];
  }

  if ( $mech eq 'symlink' && $cur eq 'env' && $entry->{env} ) {
    return [
      { mechanism => 'symlink',
        action    => 'remove-export',
        variable  => $entry->{env},
        command   => env_unset_command($entry),
        note      => "remove the 'export $entry->{env}=...' line from your shell config; the app then reads its symlink",
      } ];
  }

  return [];
} ## end sub suggested_steps

# Validate and plan an env move: the declared `rewrite` must resolve to an
# absolute XDG target that does not yet exist, and the redirect (its `env` var)
# is reconciled — an active var must point at the target (else refuse), an
# inactive one needs a named variable to instruct the export. Shared by the
# hardcoded move and the symlink->env conversion. Returns a hashref
# { tgt, active, export, err }; a defined `err` (a message) means refuse.
sub resolve_env_move {
  my ($entry) = @_;

  return { err => "no XDG target declared (needs an overlay 'rewrite')" }
    unless $entry->{rewrite};

  my $tgt = expand_path( $entry->{rewrite} );
  return { err => "target does not resolve to an absolute path ($tgt) - refused" }
    if $tgt =~ /\$\{?\w+\}?/ || !File::Spec->file_name_is_absolute($tgt);

  my $var    = $entry->{env} // '';
  my $val    = length $var ? $ENV{$var} : undef;
  my $active = defined $val && length $val;
  my $export;

  if ($active) {
    return { tgt => $tgt, err => "redirect \$$var points at $val, not the declared $tgt - reconcile first" }
      if File::Spec->canonpath($val) ne File::Spec->canonpath($tgt);
  } else {
    return { tgt => $tgt, err => 'env mechanism declares no variable - cannot instruct an export - refused' }
      unless length $var;
    $export = env_export_command($entry);
  }

  return { tgt => $tgt, err => "target $tgt already exists - a redundant leftover; use --remove" }
    if -e $tgt || -l $tgt;

  return { tgt => $tgt, active => $active, export => $export };
} ## end sub resolve_env_move

# Print the dual-audience "add the export" suggestion after an env move whose
# redirect was inactive (a human line; the same step also rides in --json's
# suggested_steps).
sub print_export_suggestion {
  my ($m) = @_;
  print "  next: add this to your shell config BEFORE running $m->{app} again:\n";
  print "      $m->{export}\n";
  return;
}

# Convert a managed symlink to an env redirect: move the dereferenced canonical
# file to the XDG target, drop the ~/.x symlink, and remove its dotlinks line.
# Reverse-order rollback on any partial failure leaves $HOME and the repo
# as they were. Returns (ok, message).
sub convert_symlink_to_env {
  my ($m) = @_;

  my ( $mok, $merr ) = move_path( $m->{canon}, $m->{tgt} );
  return ( 0, $merr ) unless $mok;

  unless ( unlink $m->{abs} ) {
    my $err = "$!";
    move_path( $m->{tgt}, $m->{canon} );  # rollback the move
    return ( 0, "could not drop the symlink $m->{abs}: $err" );
  }

  my $dl = dotlinks_file();
  if ( defined $dl ) {
    my ( $ok, $err ) = remove_dotlinks_line( $dl, $m->{linkname} );
    unless ($ok) {
      symlink( $m->{link_text}, $m->{abs} );  # recreate the link
      move_path( $m->{tgt}, $m->{canon} );
      return ( 0, "could not update $dl ($err) - reverted" );
    }
  }

  return ( 1, "converted $m->{abs} to an env redirect at $m->{tgt} (dropped the symlink + dotlinks entry)" );
} ## end sub convert_symlink_to_env

# Drop the dotlinks line(s) whose link-name matches $linkname from $file (a
# minimal, Slice-2-scoped edit; Slice 3 owns the general --remove teardown). A
# no-op when nothing matches. Returns (1, undef) on success, or (0, err) — the
# file restored to its original content on a write failure.
sub remove_dotlinks_line {
  my ( $file, $linkname ) = @_;
  return ( 1, undef ) unless defined $file && -e $file;

  my $orig = read_file($file);
  my @keep;
  for my $line ( split /^/m, $orig ) {
    my $t = $line;
    $t =~ s/\A\s+//;
    $t =~ s/\s+\z//;
    if ( length $t && $t !~ /^#/ ) {
      my ( $src, $name ) = split /\s+/, $t, 2;
      $name = ( defined $name && length $name ) ? $name : $src;
      $name =~ s{.*/}{};
      next if $name eq $linkname;
    }
    push @keep, $line;
  }

  open my $fh, '>:encoding(UTF-8)', $file or return ( 0, "$!" );
  my $ok = print {$fh} join( '', @keep );
  unless ( $ok && close $fh ) {
    my $err = "$!";
    restore_file( $file, $orig );
    return ( 0, $err );
  }
  return ( 1, undef );
} ## end sub remove_dotlinks_line

# Overwrite $file with $content (rollback helper). Best-effort.
sub restore_file {
  my ( $file, $content ) = @_;
  open my $fh, '>:encoding(UTF-8)', $file or return 0;
  print {$fh} $content;
  close $fh;
  return 1;
}

# --migrate env: move a present dotfile to its declared XDG target (`rewrite`)
# so an already-active redirect finds it there. Gated on concrete preconditions
# (NOT the display group, since the clean case classifies as 'stray'): the
# redirect must be active in THIS shell and point at the declared target, the
# target must not already exist, and the source must be a real file/dir under
# $HOME (never a symlink).
sub mode_migrate_env {
  my ($query) = @_;

  my @entries = resolve_one_app( $query, '--migrate env' ) or return 1;

  my $home = home_dir();
  print "$entries[0]{name}\n\n";

  # First pass: show each path's disposition; collect the eligible moves. A
  # managed symlink whose entry recommends env converts (symlink->env); a real
  # hardcoded file moves (Slice 1); every other case refuses.
  my @moves;
  for my $e ( sort { $a->{path} cmp $b->{path} } @entries ) {
    my $abs  = expand_path( $e->{path} );
    my $disp = home_relative( $e->{path} );
    my $mech = $e->{mechanism} // '';

    if ( $e->{ignore} ) {
      printf "  %-24s ignored (left in place)\n", $disp;
      next;
    }

    # symlink -> env conversion: drop the link + its dotlinks entry and move the
    # dereferenced canonical file to the XDG target (Slice 2).
    if ( defined link_target($e) ) {
      if ( $mech ne 'env' ) {
        printf "  %-24s linked (managed symlink), recommended %s not env - not migrated\n",
          $disp, ( length $mech ? $mech : 'none' );
        next;
      }

      require Cwd;
      my $canon = Cwd::abs_path($abs);
      unless ( defined $canon && -e $canon ) {
        printf "  %-24s broken symlink (target missing) - resolve by hand\n", $disp;
        next;
      }

      my $plan = resolve_env_move($e);
      if ( defined $plan->{err} ) { printf "  %-24s %s\n", $disp, $plan->{err}; next; }

      ( my $linkname = $abs ) =~ s{.*/}{};
      printf "  %-24s convert symlink -> move %s to %s (drop the link + dotlinks entry)\n",
        $disp, $canon, $plan->{tgt};
      push @moves, {
        convert   => 1,
        abs       => $abs,
        canon     => $canon,
        tgt       => $plan->{tgt},
        link_text => readlink($abs),
        linkname  => $linkname,
        app       => $e->{name},
        export    => $plan->{export},
      };
      next;
    } ## end if ( defined link_target...)

    if ( !path_exists($e) ) {
      printf "  %-24s absent - nothing to migrate\n", $disp;
      next;
    }
    if ( $mech ne 'env' ) {
      printf "  %-24s recommended mechanism is %s, not env - not migrated\n",
        $disp, ( length $mech ? $mech : 'none' );
      next;
    }

    my $plan = resolve_env_move($e);
    if ( defined $plan->{err} ) { printf "  %-24s %s\n", $disp, $plan->{err}; next; }
    my $tgt = $plan->{tgt};

    unless ( index( $abs, "$home/" ) == 0 ) {
      printf "  %-24s resolves outside \$HOME (%s) - refused\n", $disp, $abs;
      next;
    }

    if ( $plan->{active} ) {
      printf "  %-24s move to %s\n", $disp, $tgt;
    } else {
      printf "  %-24s move to %s  (redirect \$%s inactive - export suggested)\n",
        $disp, $tgt, $e->{env};
    }
    push @moves, { abs => $abs, tgt => $tgt, app => $e->{name}, export => $plan->{export} };
  } ## end for my $e ( sort { $a->...})

  # Second pass: confirm and perform each planned move/conversion (default No).
  # An inactive-redirect move (or a conversion needing one) prints the export.
  my $migrated = 0;
  if (@moves) {
    print "\n";
    for my $m (@moves) {
      if ( $m->{convert} ) {
        next unless prompt_yes("  Convert $m->{abs} (symlink) to an env redirect at $m->{tgt}? [y/N] ");

        my ( $ok, $msg ) = convert_symlink_to_env($m);
        if ($ok) {
  print "  $msg\n";
  print_export_suggestion($m) if defined $m->{export};
  $migrated++;
        } else {
  print {*STDERR} "  $PROG: $msg\n";
        }
        next;
      }

      next unless prompt_yes("  Move $m->{abs} -> $m->{tgt}? [y/N] ");

      my ( $ok, $err ) = move_path( $m->{abs}, $m->{tgt} );
      if ($ok) {
        print "  migrated $m->{abs} -> $m->{tgt}\n";
        print_export_suggestion($m) if defined $m->{export};
        $migrated++;
      } else {
        print {*STDERR} "  $PROG: $err\n";
      }
    } ## end for my $m (@moves)
  } ## end if (@moves)

  print "\n$PROG: migrated $migrated item(s).\n";
  return 0;
} ## end sub mode_migrate_env

# ------------------------------------------------------------------------------
# Migration to the symlink mechanism (and --fix), delegating the actual linking
# to check-dotfiles (which owns .dotlinks + `ln -fs`). A hardcoded dotfile is
# moved into the repo at its `rewrite` target, registered in a dotlinks file,
# and linked back by check-dotfiles; a loose (unregistered) symlink is just
# registered. Every step is confirmation-gated with cleanup/rollback on failure.
# ------------------------------------------------------------------------------

# --migrate symlink: put a HARDCODED dotfile under check-dotfiles management
# (move ~/.x into the repo at its `rewrite`, register it, let check-dotfiles
# link it back), or register a loose (partial) symlink. xdg-audit never runs
# `ln` itself — check-dotfiles is the sole owner of the linking.
sub mode_migrate_symlink {
  my ($query) = @_;

  my @entries = resolve_one_app( $query, '--migrate symlink' ) or return 1;

  my $home = home_dir();
  print "$entries[0]{name}\n\n";

  my @actions;
  for my $e ( sort { $a->{path} cmp $b->{path} } @entries ) {
    my ( $action, $msg ) = plan_symlink_action( $e, $home );
    printf "  %-24s %s\n", home_relative( $e->{path} ), $msg;
    push @actions, $action if $action;
  }

  return run_symlink_actions( \@actions, 'migrated' );
}

# --fix <app|$HOME-path>: complete/repair the CURRENT setup without changing
# mechanism (sugar for `--migrate <current-mechanism>`). The implemented case is
# a loose (partial) symlink -> register it so check-dotfiles maintains it.
# Refuses states with nothing to fix (hardcoded/absent/unknown -> use --migrate;
# an env leftover -> use --remove).
sub mode_fix {
  my ($query) = @_;

  unless ( defined $query && length $query ) {
    print {*STDERR} "$PROG: --fix needs an app name or \$HOME path\n";
    return 1;
  }

  my @entries = resolve_one_app( $query, '--fix' ) or return 1;

  my $home = home_dir();
  print "$entries[0]{name}\n\n";

  my @actions;
  for my $e ( sort { $a->{path} cmp $b->{path} } @entries ) {
    my ( $action, $msg ) = plan_fix_action( $e, $home );
    printf "  %-24s %s\n", home_relative( $e->{path} ), $msg;
    push @actions, $action if $action;
  }

  return run_symlink_actions( \@actions, 'fixed' );
} ## end sub mode_fix

# Validate the repo (symlink) target for an entry: $DOTFILES set, a `rewrite`
# that resolves absolute, lives under $DOTFILES, and does not already exist.
# Returns ($tgt, undef) or (undef, message). Shared by the hardcoded move and
# the env->symlink conversion (both link a repo-resident file).
sub resolve_repo_target {
  my ($e) = @_;

  my $df = $ENV{DOTFILES};
  return ( undef, '$DOTFILES is not set - required for a symlink migrate' )
    unless defined $df && length $df;

  return ( undef, "no repo target declared (needs an overlay 'rewrite' under \$DOTFILES)" )
    unless $e->{rewrite};

  my $tgt = expand_path( $e->{rewrite} );
  return ( undef, "target does not resolve to an absolute path ($tgt) - refused" )
    if $tgt =~ /\$\{?\w+\}?/ || !File::Spec->file_name_is_absolute($tgt);

  return ( undef, "target $tgt is not under \$DOTFILES - a symlink source must live in the repo" )
    unless index( $tgt, "$df/" ) == 0;

  return ( undef, "target $tgt already exists - resolve by hand" )
    if -e $tgt || -l $tgt;

  return ( $tgt, undef );
} ## end sub resolve_repo_target

# Decide what --migrate symlink should do with one entry, and the disposition
# line to show. Returns ($action, $message): $action is a hashref
# { entry, kind => 'full'|'register', source, linkname, abs[, tgt, move_src,
# unset] } when actionable, else (undef, refusal-message). 'full' moves a file
# into the repo then links it (a hardcoded ~/.x, or — for an env->symlink
# conversion — the file at $ENV{<env>}); 'register' records a loose symlink.
sub plan_symlink_action {
  my ( $e, $home ) = @_;

  return ( undef, 'ignored (left in place)' ) if $e->{ignore};

  my $abs = expand_path( $e->{path} );
  ( my $linkname = $abs ) =~ s{.*/}{};
  my $cur = current_mechanism($e);

  if ( $cur eq 'symlink' ) {
    return ( undef, 'already a registered symlink (complete) - nothing to do' )
      if dotlinks_registered($e);

    # A loose symlink: register its current (canonical) target, no move.
    require Cwd;
    my $target = Cwd::abs_path($abs) // link_target($e);
    my $source = dotlinks_source_token($target);
    return (
      { entry => $e, kind => 'register', source => $source, linkname => $linkname, abs => $abs },
      "loose symlink -> register $source"
    );
  }

  return ( undef, 'absent - nothing to migrate' )                if $cur eq 'absent';
  return ( undef, 'current mechanism unknown - cannot migrate' ) if $cur eq 'unknown';

  # env -> symlink conversion (Slice 2): the entry must RECOMMEND symlink (its
  # `rewrite` is the repo target), name the `env` var currently redirecting it,
  # that var must point at an existing file (the one to move into the repo), and
  # ~/.x must be free for check-dotfiles to create the link.
  if ( $cur eq 'env' ) {
    return (
      undef,
      'using env; recommended mechanism is '
        . ( length( $e->{mechanism} // '' ) ? $e->{mechanism} : 'none' )
        . ', not symlink - nothing to convert (use --migrate env, or --remove a leftover)'
    ) unless ( $e->{mechanism} // '' ) eq 'symlink';

    my ( $ctgt, $cerr ) = resolve_repo_target($e);
    return ( undef, $cerr ) if defined $cerr;

    my $src = $ENV{ $e->{env} };
    return (
      undef,
      "redirect \$$e->{env} points at "
        . ( defined $src && length $src ? $src : '(unset)' )
        . ', which does not exist - nothing to move'
    ) unless defined $src && length $src && -e $src;

    return ( undef, 'a $HOME leftover at ' . home_relative( $e->{path} ) . ' blocks the link - --remove it first' )
      if path_exists($e) || defined link_target($e);

    return (
      { entry    => $e,
        kind     => 'full',
        move_src => $src,
        source   => $e->{rewrite},
        linkname => $linkname,
        abs      => $abs,
        tgt      => $ctgt,
        unset    => $e->{env},
      },
      "using env -> convert: move $src into repo -> $ctgt, link, then remove export \$$e->{env}"
    );
  } ## end if ( $cur eq 'env' )

  # $cur eq 'hardcoded' — the prize. The source must physically live in the repo
  # for check-dotfiles to link from it, so require a `rewrite` under $DOTFILES.
  my ( $tgt, $err ) = resolve_repo_target($e);
  return ( undef, $err ) if defined $err;

  unless ( index( $abs, "$home/" ) == 0 ) {
    return ( undef, "resolves outside \$HOME ($abs) - refused" );
  }

  return (
    { entry => $e, kind => 'full', source => $e->{rewrite}, linkname => $linkname, abs => $abs, tgt => $tgt },
    "move into repo -> $tgt, then link"
  );
} ## end sub plan_symlink_action

# Decide what --fix should do with one entry. A symlink defers to the migrate-
# symlink planner (complete -> nothing to do; partial -> register). --fix never
# changes mechanism, so a divergence points at --migrate; everything else has
# nothing to *fix* (hardcoded/absent/unknown needs --migrate; an env leftover
# overlaps --remove).
sub plan_fix_action {
  my ( $e, $home ) = @_;

  return ( undef, 'ignored (left in place)' ) if $e->{ignore};

  my $cur = current_mechanism($e);
  return plan_symlink_action( $e, $home ) if $cur eq 'symlink';

  if ( $cur eq 'env' ) {
    return ( undef, 'using env, recommended symlink - run --migrate symlink (or --migrate recommended) to convert' )
      if ( $e->{mechanism} // '' ) eq 'symlink';
    return ( undef, 'using env; fixing an env leftover overlaps --remove - use --remove' );
  }

  return ( undef, "nothing to fix for a $cur setup - use --migrate <target> to choose a mechanism" );
}

# Render a symlink source for a .dotlinks line, keeping it host-portable: a path
# under $DOTFILES is re-tokenized to the literal $DOTFILES (check-dotfiles
# envsubst-expands it); any other absolute path is written verbatim.
sub dotlinks_source_token {
  my ($path) = @_;
  my $df = $ENV{DOTFILES};
  return '$DOTFILES' . substr( $path, length $df )
    if defined $df && length $df && index( $path, "$df/" ) == 0;
  return $path;
}

# Print the dual-audience "remove the export" suggestion after an env->symlink
# conversion (the sibling of print_export_suggestion; the step also rides in
# --json's suggested_steps as a 'remove-export' action).
sub print_unset_suggestion {
  my ($action) = @_;
  print "  next: remove the export from your shell config (the app now reads its symlink):\n";
  print "      unset $action->{unset}    # and delete its 'export $action->{unset}=...' line\n";
  return;
}

# Execute the collected symlink actions: resolve the dotlinks file once (may
# prompt to bootstrap ~/.dotlinks), then confirm and run each action (default
# No). A bootstrapped ~/.dotlinks that ends up holding nothing is removed, so a
# fully-declined run leaves no trace. Returns 0 (1 only never happens here).
sub run_symlink_actions {
  my ( $actions, $verb ) = @_;

  unless (@$actions) {
    print "\n$PROG: nothing to $verb.\n";
    return 0;
  }

  my ( $dl_file, $preexisted ) = dotlinks_target_file();
  unless ( defined $dl_file ) {
    print "\n$PROG: no dotlinks file chosen; nothing done.\n";
    return 0;
  }

  print "\n";
  my $done = 0;
  for my $action (@$actions) {
    my $prompt;
    if ( $action->{unset} ) {
      $prompt = "  Move $action->{move_src} into the repo, link $action->{abs}, and drop export \$$action->{unset}? [y/N] ";
    } elsif ( $action->{kind} eq 'full' ) {
      $prompt = "  Move $action->{abs} into the repo and link it? [y/N] ";
    } else {
      $prompt = "  Register $action->{abs} in $dl_file? [y/N] ";
    }
    next unless prompt_yes($prompt);

    my ( $ok, $msg ) = do_symlink_action( $action, $dl_file );
    if ($ok) {
      print "  $msg\n";
      print_unset_suggestion($action) if $action->{unset};
      $done++;
    } else {
      print {*STDERR} "  $PROG: $msg\n";
    }
  } ## end for my $action (@$actions)

  # Undo a bootstrapped ~/.dotlinks that nothing landed in (restore the state).
  unlink $dl_file if !$preexisted && $done == 0 && -e $dl_file;

  print "\n$PROG: $verb $done item(s).\n";
  return 0;
} ## end sub run_symlink_actions

# Execute one symlink action with rollback on any partial failure. 'full' moves
# ~/.x into the repo (freeing ~/.x), appends the dotlinks line, then lets
# check-dotfiles create ~/.x -> the repo copy; 'register' only appends the line
# for an already-present loose symlink. The authoritative success signal is the
# link itself (check-dotfiles' exit code is unreliable). Returns (ok, message).
sub do_symlink_action {
  my ( $action, $dl_file ) = @_;
  my $abs = $action->{abs};

  # The file to move: ~/.x for a hardcoded migrate, or $ENV{<env>} for an
  # env->symlink conversion (move_src). The rollback destination is the same.
  my $move_src = $action->{move_src} // $abs;

  if ( $action->{kind} eq 'full' ) {
    my ( $mok, $merr ) = move_path( $move_src, $action->{tgt} );
    return ( 0, $merr ) unless $mok;
  }

  my ( $aok, $prior ) = append_dotlinks_line( $dl_file, $action->{source}, $action->{linkname} );
  unless ($aok) {
    move_path( $action->{tgt}, $move_src ) if $action->{kind} eq 'full';  # roll the move back
    return ( 0, "could not update $dl_file: $prior" );
  }

  my ($rc) = run_check_dotfiles();

  if ( symlink_ok( $abs, $action ) ) {
    return (
      1,
      $action->{kind} eq 'full'
      ? "migrated $move_src -> $action->{tgt} (linked, registered in $dl_file)"
      : "registered $abs in $dl_file"
    );
  }

  # The link was not created: strip our dotlinks line, remove any stray link,
  # and move the file back so $HOME and the repo are left as they were.
  truncate_file( $dl_file, $prior );
  if ( $action->{kind} eq 'full' ) {
    remove_path($abs) if -l $abs;
    move_path( $action->{tgt}, $move_src );
  }
  return ( 0, "check-dotfiles did not create the link for $abs (rc=$rc) - reverted" );
} ## end sub do_symlink_action

# The link is good when ~/.x is a symlink that resolves; for a 'full' migrate we
# additionally confirm it resolves to the exact repo target we moved into (so a
# pre-existing unrelated link can't read as success).
sub symlink_ok {
  my ( $abs, $action ) = @_;
  return 0 unless -l $abs && -e $abs;
  return 1 unless $action->{kind} eq 'full';

  require Cwd;
  my $got  = Cwd::abs_path($abs)             // '';
  my $want = Cwd::abs_path( $action->{tgt} ) // '';
  return ( length $got && $got eq $want ) ? 1 : 0;
}

# Append "<source> [<link-name>]" to the dotlinks file (link-name omitted when
# it matches the source basename, per the file's convention). Returns (1, prior)
# so a later failure can truncate the file back to where it was, or (0, err).
sub append_dotlinks_line {
  my ( $file, $source, $linkname ) = @_;

  my $prior = -e $file ? -s $file : 0;
  ( my $base = $source ) =~ s{.*/}{};
  my $line =
    ( defined $linkname && length $linkname && $linkname ne $base )
    ? "$source $linkname\n"
    : "$source\n";

  open my $fh, '>>:encoding(UTF-8)', $file or return ( 0, "$!" );
  my $ok = print {$fh} $line;
  close $fh or return ( 0, "$!" );
  return $ok ? ( 1, $prior ) : ( 0, 'write failed' );
}

# Truncate a file back to $len bytes (dotlinks-line rollback). Best-effort.
sub truncate_file {
  my ( $file, $len ) = @_;
  open my $fh, '+<', $file or return 0;
  my $ok = truncate $fh, $len;
  close $fh;
  return $ok ? 1 : 0;
}

# Run the sibling check-dotfiles — the sole owner of `ln -fs` — capturing its
# output so its chatter stays out of ours. It reads $HOME/$DOTFILES from the
# environment (it ignores --home), so pin $HOME to our resolved home. The exit
# code is a weak signal (it almost always exits 0); the caller verifies it.
sub run_check_dotfiles {
  my $cd = File::Spec->catfile( $RealBin, 'check-dotfiles' );
  return ( -1, '' ) unless -x $cd;

  local $ENV{HOME} = home_dir();
  open my $fh, '-|', $cd or return ( -1, "cannot run check-dotfiles: $!" );
  local $/;
  my $out = <$fh>;
  close $fh;
  return ( $? >> 8, $out // '' );
}

# Choose the dotlinks file to append to, bootstrapping ~/.dotlinks when it is
# absent. All prompts default No, so a non-interactive/fixture run declines and
# aborts cleanly. Prints the $DOTFILES/dotlinks-* files, marking the active one
# (check-dotfiles reads ~/.dotlinks if present, else the dotlinks-default).
# Returns ($file, $preexisted), or an empty list if the user declines.
sub dotlinks_target_file {
  my $home = home_dir();
  my $user = File::Spec->catfile( $home, '.dotlinks' );
  my $df   = $ENV{DOTFILES};
  my $def  = ( defined $df && length $df ) ? File::Spec->catfile( $df, 'dotlinks-default' ) : undef;

  list_dotlinks_files( $df, ( -e $user ? $user : $def ) );

  return ( $user, 1 ) if -e $user;     # ~/.dotlinks is the active file already

  # ~/.dotlinks absent: offer to bootstrap it (the active file check-dotfiles
  # would read), else fall back to the shared, tracked dotlinks-default.
  if ( prompt_yes("  Create $user (your personal, active dotlinks file)? [y/N] ") ) {
    my $seed = ( $def && -r $def && prompt_yes("  Seed it from $def? [y/N] ") ) ? read_file($def) : '';

    open my $fh, '>:encoding(UTF-8)', $user or do {
      print {*STDERR} "  $PROG: cannot create $user: $!\n";
      return;
    };
    print {$fh} $seed;
    close $fh;
    return ( $user, 0 );
  }

  return ( $def, 1 )
    if $def && prompt_yes("  Append to $def instead (shared, tracked - affects every host)? [y/N] ");

  return;
} ## end sub dotlinks_target_file

# List the dotlinks-* files present in $DOTFILES, marking the active one. Purely
# informational, shown before the bootstrap prompts.
sub list_dotlinks_files {
  my ( $df, $active ) = @_;
  return unless defined $df && length $df && -d $df;

  opendir my $dh, $df or return;
  my @names = sort grep { /^dotlinks-/ } readdir $dh;
  closedir $dh;
  return unless @names;

  print "  dotlinks files in \$DOTFILES:\n";
  for my $name (@names) {
    my $full = File::Spec->catfile( $df, $name );
    printf "    %s%s\n", $full, ( defined $active && $full eq $active ) ? ' (active)' : '';
  }
  print "\n";
  return;
}

# ------------------------------------------------------------------------------
# Database lifecycle
# ------------------------------------------------------------------------------

sub mode_reindex {
  my $n = build_index();
  print "$PROG: rebuilt index with $n path entries.\n" unless $cli{json};
  emit_json( { reindexed => $n } ) if $cli{json};
  return 0;
}

# Refresh the pristine mirror from upstream, then flag overrides whose recorded
# upstream digest no longer matches (i.e. upstream likely caught up).
sub mode_update_db {
  my ($ref_arg) = @_;
  my $dbd       = db_dir();
  my $pin       = decode_file( File::Spec->catfile( $dbd, 'upstream.json' ) );
  my $repo      = $pin->{repo};
  my $ref       = $ref_arg || 'HEAD';

  require File::Temp;
  my $tmp   = File::Temp::tempdir( CLEANUP => 1 );
  my @clone = ( 'git', 'clone', '--quiet', '--depth', '1' );
  push @clone, ( '--branch', $ref ) if $ref ne 'HEAD';
  push @clone, ( $repo, $tmp );
  system(@clone) == 0 or die "$PROG: git clone of $repo failed\n";

  my $new_sha = qx(git -C "$tmp" rev-parse HEAD);
  chomp $new_sha;

  # Snapshot old overrides' recorded digests before overwriting the mirror.
  my $local = name_index('programs-local');
  my %override_digest;
  for my $name ( keys %$local ) {
    my $d = eval { decode_file( $local->{$name} ) } or next;
    $override_digest{$name} = $d->{'upstream-digest'} if $d->{'upstream-digest'};
  }

  # Overwrite schema + programs from the fresh clone (keep the mirror pristine).
  my $prog_dst = File::Spec->catdir( $dbd, 'programs' );
  my $prog_src = File::Spec->catdir( $tmp, 'programs' );

  my @changed;
  opendir my $dh, $prog_src or die "$PROG: no programs/ in clone\n";
  for my $f ( readdir $dh ) {
    next unless $f =~ /\.json$/;
    my $src    = File::Spec->catfile( $prog_src, $f );
    my $dst    = File::Spec->catfile( $prog_dst, $f );
    my $before = ( -f $dst ) ? sha256_hex( read_file($dst) ) : '';
    my $after  = sha256_hex( read_file($src) );
    if ( $before ne $after ) {
      _copy( $src, $dst );
      ( my $name = $f ) =~ s/\.json$//;
      push @changed, $name;
    }
  }
  closedir $dh;

  _copy(
    File::Spec->catfile( $tmp, 'json-schema', 'program.json' ),
    File::Spec->catfile( $dbd, 'json-schema', 'program.json' ),
  );

  # Record the new pin.
  $pin->{ref} = $new_sha;
  open my $pf, '>:encoding(UTF-8)', File::Spec->catfile( $dbd, 'upstream.json' )
    or die "$PROG: cannot update upstream.json: $!\n";
  print {$pf} JSON::PP->new->utf8(0)->canonical->pretty->encode($pin);
  close $pf;

  build_index();

  # Flag overrides that may now be obsolete.
  my @obsolete;
  for my $name ( keys %override_digest ) {
    my $up = File::Spec->catfile( $prog_dst, "$name.json" );
    next unless -f $up;
    my $now = sha256_hex( read_file($up) );
    push @obsolete, $name if $now ne $override_digest{$name};
  }

  if ( $cli{json} ) {
    emit_json( { ref => $new_sha, changed => \@changed, obsolete_overrides => \@obsolete } );
  } else {
    print "$PROG: updated to $new_sha\n";
    print "  changed programs: " . ( @changed ? join( ', ', sort @changed ) : 'none' ) . "\n";
    if (@obsolete) {
      print "  overrides possibly obsolete (upstream changed since the override):\n";
      print "    $_  - review programs-local/$_.json; remove if upstream now suffices\n" for sort @obsolete;
    }
  }
  return 0;
} ## end sub mode_update_db

sub _copy {
  my ( $src, $dst ) = @_;
  my $data = read_file($src);
  open my $fh, '>:encoding(UTF-8)', $dst or die "$PROG: cannot write $dst: $!\n";
  print {$fh} $data;
  close $fh;
  return;
}

# ------------------------------------------------------------------------------
# Usage / dispatch
# ------------------------------------------------------------------------------

sub usage {
  my ( $code, $brief ) = @_;
  $code //= 0;
  my $help = <<'END_USAGE';
xdg-audit - audit $HOME for dotfiles that could move to XDG locations.

USAGE
  xdg-audit [options]              scan $HOME for stray dotfiles
  xdg-audit [options] <app>        show what one app needs + live status
  xdg-audit [options] <$HOME-path> reverse-map a dotfile to its app
  xdg-audit --search <term>        search name/path/help text
  xdg-audit --remove <app|path>    delete a confirmed leftover (asks first)
  xdg-audit --migrate env <app|path>      move a dotfile to its XDG target (asks)
  xdg-audit --migrate symlink <app|path>  move into the repo + symlink (asks)
  xdg-audit --migrate recommended <app>   use the declared mechanism (asks)
  xdg-audit --fix <app|path>       complete/repair the current setup (asks)
  xdg-audit --reindex              rebuild the enriched index cache
  xdg-audit --update-db [<ref>]    refresh the vendored mirror from upstream

OPTIONS
  -a, --all                also show handled/ignored/linked/unknown, tagged
  --json                   machine-readable output (for tooling / AI)
  --search <term>          substring search across name, path, and help
  --remove                 delete a confirmed leftover for <app|path> (asks)
  --migrate <mechanism>    transition <app|path> to <mechanism>
                           (env, symlink, recommended; asks)
  --fix                    complete/repair <app|path>'s current setup (asks)
  --mechanism <m>          restrict the scan to one mechanism (env/alias/wrap)
  --movable / --immovable  filter the scan by movability
  --db <dir>               database dir (default: $XDG_CONFIG_HOME/xdg-audit)
  --home <dir>             treat <dir> as $HOME (testing)
  --reindex                force-rebuild the index before running
  -h                       brief usage (synopsis + options)
  --help                   full help (adds OUTPUT/REMOVE/MIGRATE/EXIT STATUS)

OUTPUT
  The default scan lists only actionable dotfiles, grouped by type (empty
  groups omitted):

    unhandled  Present but not redirected yet (mechanism inactive, or
               nothing recorded).
    stray      Present, and its redirect is already active -> the leftover
               file is safe to remove.
    remove     The app is marked unused; just delete the file.

  -a/--all also shows the non-actionable groups the default scan hides -
  'handled' (migrated: gone from $HOME, redirect active), 'ignored'
  (deliberately left in place, with a short reason), 'linked' (a symlink into
  another repo), and 'unknown' (a $HOME dotfile no db entry covers) - and tags
  every entry with its mechanism. An app's dotfiles collapse onto one line:
  "app (.a,.b) (env)"; a symlink reads "app (.x) -> target (external)"; an
  ignored entry appends its reason: "app (.x) (ignore) - why". Tags: the
  redirect mechanism (env/alias/symlink/wrap), "external" (symlink), "ignore",
  "remove", or "overlay" (a path our overlay adds but has not redirected).

  An exact app name shows that app's detail (a paths list, then each path's
  migration help); so does a fragment that matches only one app. A fragment
  matching several apps shows a per-app list. In a detail view a path reads as
  "-> target" (linked), "absent", "ignored" (with its reason), or its group
  word. When the CURRENT (detected) mechanism diverges from the RECOMMENDED
  (declared) one, the line appends "(recommended: <mechanism>)"; an externally
  managed path appends "[owner: <who>]" (e.g. a symlink -> check-dotfiles).

  --json emits a flat array; every record (handled, ignored, and unknown
  included) carries its "group" for tooling and agents, plus the mechanism
  state: "current_mechanism" (symlink / env / hardcoded / unknown / absent),
  "recommended_mechanism" (the declared one), "current_completeness"
  (complete/partial for a symlink, clean/leftover for an env redirect),
  "divergence" (a recommended-vs-actual verdict), "owner", and
  "suggested_steps" - an array of the "instruct the rest" steps an agent can
  apply (currently the "export VAR=..." a hardcoded env-recommended path needs;
  empty once the redirect is active).

REMOVE
  --remove <app|$HOME-path> deletes a confirmed leftover, or tears down a
  managed symlink. Deletable: a 'stray' (present, redirect active AND its
  target actually exists) or a 'remove'-marked (unused app) file. A stray whose
  redirect target does NOT exist is refused (its $HOME copy is the only one -
  migrate it with --migrate env, don't delete). A check-dotfiles-managed
  (registered) symlink is TORN DOWN - the link is removed and its dotlinks
  entry dropped, while the canonical repo file is left intact; a loose or
  external symlink, or an un-redirected ('unhandled') file, is refused. It
  shows the status, then asks before each change (default No); every change is
  confined to $HOME. Name the app or path; --remove never sweeps the whole scan.

MIGRATE
  --migrate <mechanism> <app|$HOME-path> transitions the target to <mechanism>.
  The mechanism is required (no default); 'env', 'symlink', and 'recommended'
  are implemented (the rest come in later phases - see ADR-0004), so the old
  bare 'xdg-audit --migrate <app>' is now 'xdg-audit --migrate env <app>'.

  --migrate recommended <app|path> resolves the target's declared mechanism (the
  overlay 'mechanism') and dispatches to it (env/symlink). It refuses when an
  app owns paths with different recommended mechanisms (run --migrate <mechanism>
  per mechanism, or name a single $HOME path), when the recommendation is one
  --migrate cannot yet perform (alias/wrap/remove), or when no mechanism is
  declared.

  --migrate env moves a present dotfile to its declared XDG target (the
  overlay's 'rewrite'), so an already-active redirect finds it there. When the
  redirect is active it must point at the declared target (else it refuses -
  reconcile first). When the redirect is NOT active it still moves the file and
  prints the exact 'export VAR=<target>' line to add to your shell config
  BEFORE running the app again (automate the move, instruct the export - the
  same step also rides in --json's suggested_steps for an agent to apply). It
  refuses when the target already exists (a redundant leftover - use --remove),
  when either path escapes $HOME, or when an env-recommended entry declares no
  variable to export. When the $HOME path is instead a MANAGED SYMLINK and the
  entry recommends env, --migrate env CONVERTS it (symlink -> env): it drops the
  link + its dotlinks entry, moves the dereferenced canonical file to the XDG
  target, and instructs the export (rolling back on any partial failure).

  --migrate symlink puts a HARDCODED dotfile (a present real file, no redirect)
  under check-dotfiles management: it moves the file into the repo at its
  declared 'rewrite' (which must live under $DOTFILES - a symlink source must be
  repo-resident), registers it in a dotlinks file, then runs check-dotfiles to
  create the $HOME symlink back to the repo copy. xdg-audit never runs 'ln'
  itself; check-dotfiles owns the linking. It offers to bootstrap ~/.dotlinks
  (the active dotlinks file) when absent, or to append to the shared, tracked
  $DOTFILES/dotlinks-default. It writes into the TRACKED repo but never commits
  - the git commit stays yours. A partial-failure rolls back (the file is moved
  back and the dotlinks line stripped). It refuses when no repo 'rewrite' is
  declared, the target is outside $DOTFILES or already exists, or the source
  escapes $HOME. When the path is instead currently redirected by an env var and
  the entry recommends symlink (declaring that 'env' var), --migrate symlink
  CONVERTS it (env -> symlink): it moves the file at $ENV{<env>} into the repo,
  links it, and instructs REMOVING the export (a 'remove-export' suggested step).

  Both --migrate modes ask before each change (default No) and never sweep the
  whole scan.

FIX
  --fix <app|$HOME-path> completes or repairs the CURRENT setup without changing
  mechanism - it is sugar for '--migrate <current-mechanism>'. The implemented
  case is a loose symlink (a real symlink NOT registered in the dotlinks file,
  reported as 'partial'): --fix registers it (source = the link's current
  target) and runs check-dotfiles so the link is maintained from then on. It
  refuses a hardcoded/absent/unknown path (nothing to fix - use --migrate to
  choose a mechanism) and an env leftover (use --remove). Asks first (default
  No).

EXIT STATUS
  0  nothing actionable (no unhandled / stray / remove found)
  2  actionable findings (any unhandled / stray / remove)
  1  a usage or runtime error
END_USAGE

  # -h prints the brief form (synopsis + options); --help prints all. Keeping
  # one heredoc and truncating it at the OUTPUT section keeps the two in sync.
  $help =~ s/\nOUTPUT\n.*//s if $brief;

  print $help;
  exit $code;
} ## end sub usage

# ------------------------------------------------------------------------------

GetOptions(
  'json'        => \$cli{json},
  'all|a'       => \$cli{all},
  'search=s'    => \$cli{search},
  'mechanism=s' => \$cli{mechanism},
  'movable'     => sub { $cli{movable} = 1 },
  'immovable'   => sub { $cli{movable} = 0 },
  'db=s'        => \$cli{db},
  'home=s'      => \$cli{home},
  'reindex'     => \$cli{reindex},
  'update-db'   => \$cli{update_db},
  'remove'      => \$cli{remove},
  'migrate'     => \$cli{migrate},
  'fix'         => \$cli{fix},
  'help'        => sub { usage( 0, 0 ) },
  'h'           => sub { usage( 0, 1 ) },
) or usage( 1, 1 );

# Dispatch. A runtime failure (e.g. missing database) reports and exits 1;
# a scan with actionable findings returns 2; a clean run returns 0.
my $exit = eval {
  if    ( $cli{update_db} )         { mode_update_db( $ARGV[0] ) }
  elsif ( $cli{remove} )            { mode_remove( $ARGV[0] ) }
  elsif ( $cli{fix} )               { mode_fix( $ARGV[0] ) }
  elsif ( $cli{migrate} )           { mode_migrate( $ARGV[0], $ARGV[1] ) }
  elsif ( defined $cli{search} )    { mode_search( $cli{search} ) }
  elsif ( $cli{reindex} && !@ARGV ) { mode_reindex() }
  elsif (@ARGV)                     { mode_lookup( $ARGV[0] ) }
  else                              { mode_scan() }
};
if ( !defined $exit ) {
  print {*STDERR} $@ if $@;
  $exit = 1;
}

exit $exit;

__END__

=encoding utf8

=head1 NAME

xdg-audit - audit $HOME for dotfiles that could move to XDG locations

=head1 SYNOPSIS

  xdg-audit [options]              # scan $HOME
  xdg-audit vim                    # what vim needs + live status
  xdg-audit .some-dir              # reverse-map a $HOME path to its app
  xdg-audit --search gradle        # search name/path/help
  xdg-audit --remove docker        # delete a confirmed leftover (asks first)
  xdg-audit --migrate env bash     # move a dotfile to its XDG target (asks)
  xdg-audit --migrate symlink grok # move into the repo + symlink (asks)
  xdg-audit --fix grok             # register a loose symlink (asks)
  xdg-audit --json                 # machine-readable output
  xdg-audit --reindex              # rebuild the index cache
  xdg-audit --update-db            # refresh the vendored xdg-ninja mirror

=head1 DESCRIPTION

C<xdg-audit> reports dotfiles in C<$HOME> that a program supports relocating to
an XDG base directory, using a vendored, schema-validated mirror of xdg-ninja's
program database plus a local overlay (C<programs-local/>) that overrides stale
upstream entries, adds programs upstream does not cover, marks paths to ignore,
and annotates each path with a recommended handling I<mechanism> (env / alias /
symlink / wrap / remove).

Alongside that recommended mechanism, xdg-audit detects the I<current>
mechanism from C<$HOME> state — C<symlink>, C<env>, C<hardcoded> (a present,
unmanaged file, the state to migrate away from), or C<unknown> — and reports
where the two diverge, so a lookup or the C<--json> feed shows both "what
should handle this" and "what does". A path an external tool manages (a
C<symlink> is owned by C<check-dotfiles>) is tagged with its C<owner>.

Every reporting mode honours C<--json> so both a human and an agent can
consume the output. The scan and lookups never touch C<$HOME>; the mutating
modes are C<--remove>, which deletes a confirmed leftover (a I<stray> whose
redirect target exists, or a I<remove>-marked file) or tears down a
check-dotfiles-managed symlink (dropping the link + its dotlinks entry, keeping
the repo file); C<--migrate> C<< <mechanism> >>, which transitions a
target to a mechanism (the mechanism is required — C<env> I<moves> a present
dotfile to its declared XDG target, and when the redirect is not yet active it
emits the C<export> line to add as a dual-audience suggestion; C<symlink> puts a
hardcoded dotfile under C<check-dotfiles> management by moving it into the repo,
registering it in a dotlinks file, and letting C<check-dotfiles> link it back;
C<recommended> resolves the declared mechanism and dispatches to it; the rest
arrive in later phases, see C<ADR-0004>). C<--migrate> also performs the
C<< env <-> symlink >> conversions between those states: a managed symlink whose
entry recommends env converts to an env redirect, and an env-redirected path
whose entry recommends symlink converts to a repo symlink (instructing the
C<export> to add or the export to remove). Finally C<--fix> completes or repairs
the current setup without changing mechanism (sugar for
C<< --migrate <current-mechanism> >>, e.g. registering a loose symlink). Each
acts on a named app or path and asks for confirmation first (see the B<REMOVE>,
B<MIGRATE>, and B<FIX> sections of C<--help>). The C<--json> feed carries a
C<suggested_steps> array per record — the instructed steps (an C<export> to add
or C<remove-export> to drop) an agent can apply. See the B<OUTPUT> section for
what each reported status means.

=head2 Loading strategy

Scans, lookups, and filters resolve against a generated enriched index
(C<.index.json>) that carries the cheap structured fields; when a lookup
narrows to a single app, that app's file is read for its help/detail. Program
bodies are otherwise parsed only to build the index (or on a C<--search>, which
scans help text). The index rebuilds automatically when the C<programs*/>
directories are newer, or on C<--reindex>.

=head1 EXIT STATUS

Exits C<0> when nothing is actionable (only handled/linked/ignored, or a
successful lookup), C<2> when the scan finds actionable work (any unhandled /
stray / remove), and C<1> on a usage or runtime error.

=head1 SEE ALSO

C<config/xdg-audit/README.md> for the data model, mechanism hierarchy, and the
update/submit workflow.

=cut
