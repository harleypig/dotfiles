# Perl::Critic profile for this repo.
#
# Design: a curated, CORE-only profile gated at severity 1. It deliberately
# replaces an earlier 2287-line generated dump that ran at `severity = brutal`
# and referenced third-party policy bundles (OTRS, TryTiny, Bangs, logicLAB,
# Moose, Tics, StricterSubs, Reneeb's ProhibitAccessOfPrivateData, …) that are
# not part of the Perl::Critic distribution. Those bundles buried real
# findings in noise and only survived because `profile-strictness = warn`
# downgraded the resulting unknown-policy errors — "worse than nothing."
#
# This profile references ONLY policies shipped in the core Perl-Critic dist,
# so it is deterministic and matches the gate exactly: the pre-commit / CI
# gate runs perlcritic from a pinned `FROM perl + cpanm Perl::Critic` docker
# image (a controlled policy set with none of the machine's stray third-party
# bundles). NEVER reference a non-core policy here — the gate image would not
# have it installed, which would reintroduce the unknown-policy error the
# dropped `profile-strictness = warn` crutch used to mask.
#
# Severity ladder (see the dotagents repo's rules/perlcritic.md): 5 = most
# severe … 1 = brutal. We gate at 1, the bottom of the ladder, so every core
# policy applies except the ones switched off below, each with its reason.
# Loosening a policy is therefore an edit here, never a lower `severity`.

severity = 1
verbose  = %f:%l:%c [%p] %m (severity %s)\n

# Postfix controls stay prohibited at the policy's defaults. The guard
# clauses this code relies on are already allowed: a postfix `if` after a
# loop break or `return` (`return if …`, `next if …`) and after a
# `flowcontrol` function (`die … if …`). What the policy flags is the
# `unless` spelling of those guards and a postfix on an ordinary statement,
# and both are cleared rather than allowed: the guards are written
# `return if !…`, the form the newer code here already uses, and the rest
# become blocks. Allowing `unless` would also permit it on ordinary
# statements, which hides the control flow this policy is about.
[ControlStructures::ProhibitPostfixControls]

# These CLIs document their interface as NAME, SYNOPSIS, DESCRIPTION,
# OPTIONS and EXIT STATUS (ADR-0002: the interface is the CLI, documented in
# the OPTIONS POD). The policy's default script list is a distribution
# template (AUTHOR, LICENSE AND COPYRIGHT, INCOMPATIBILITIES, …) that would
# be empty boilerplate in a personal dotfiles script, so require the
# sections these scripts already use instead.
[Documentation::RequirePodSections]
script_sections = NAME | SYNOPSIS | DESCRIPTION | OPTIONS | EXIT STATUS

# open and close stay checked; print and say do not. A filehandle is
# buffered, so a print's return value reports a failed write only when that
# print happens to flush. The error otherwise surfaces at close, and an
# explicit close stays checked here and by InputOutput::RequireCheckedClose.
# Checking each print would add an `or die` to every line of output while
# still missing most write failures.
[InputOutput::RequireCheckedSyscalls]
exclude_functions = print say

# A $VERSION is a module's interface: what `use Module 1.2` and the CPAN
# toolchain read. Everything this profile gates is a script under bin/, where
# nothing reads one, and an unread version string is never bumped, so it
# would misstate the script rather than describe it. The scripts' version is
# their git history. The policy is therefore off rather than satisfied with a
# placeholder.
[-Modules::RequireVersionVar]

# The ranges these CLIs enumerate are a shell variable name's, which POSIX
# defines as ASCII letters, digits and underscore. The named class the
# policy asks for is not the same set: [[:alpha:]] matches any letter Perl
# knows, so on a decoded argument (PERL_UNICODE=A) it accepts `é`, which no
# shell accepts as a name. The explicit range is the exact rule, so the
# policy is off rather than satisfied with a wider class.
[-RegularExpressions::ProhibitEnumeratedClasses]

# Every string this policy flags in these CLIs carries a deliberate literal
# sigil: a `$1` handed to `sh -c`, or `$HOME` / `$DOTFILES` named in a
# message. The one other spelling, an escaped sigil in double quotes, is
# flagged in turn by ValuesAndExpressions::ProhibitInterpolationOfLiterals,
# so the two policies cannot both pass on a literal `$`. Single quotes are
# the clearer of the two, so this policy is off.
[-ValuesAndExpressions::RequireInterpolationOfMetachars]
