# Perl::Critic profile for this repo.
#
# Design: a curated, CORE-only profile gated at severity 3. It deliberately
# replaces an earlier 2287-line generated dump that ran at `severity = brutal`
# and referenced third-party policy bundles (OTRS, TryTiny, Bangs, logicLAB,
# Moose, Tics, StricterSubs, Reneeb's ProhibitAccessOfPrivateData, …) that are
# not part of the Perl::Critic distribution. Those bundles buried real findings
# in noise and only survived because `profile-strictness = warn` downgraded the
# resulting unknown-policy errors — "worse than nothing."
#
# This profile references ONLY policies shipped in the core Perl-Critic dist,
# so it is deterministic and matches the gate exactly: the pre-commit / CI gate
# runs perlcritic from a pinned `FROM perl + cpanm Perl::Critic` docker image
# (a controlled policy set with none of the machine's stray third-party
# bundles). NEVER reference a non-core policy here — the gate image would not
# have it installed, which would reintroduce the unknown-policy error the
# dropped `profile-strictness = warn` crutch used to mask.
#
# Severity ladder (see the dotagents repo's rules/perlcritic.md): 5 = most
# severe … 1 = brutal. We gate at 3 ("harsh") and ratchet toward 1 in stages,
# cleaning each level's findings before tightening. Bump `severity` below to
# tighten; the staged ratchet is #361 - perlcritic severity ratchet.

severity = 3
verbose  = %f:%l:%c [%p] %m (severity %s)\n

# Postfix controls stay prohibited at the policy's defaults. The guard
# clauses this code relies on are already allowed: a postfix `if` after a
# loop break or `return` (`return if …`, `next if …`) and after a
# `flowcontrol` function (`die … if …`). What the policy flags is the
# `unless` spelling of those guards and a postfix on an ordinary statement,
# and both are cleared rather than allowed: the guards are written
# `return if !…`, the form the newer code here already uses, and the rest
# become blocks. Allowing `unless` would also permit it on ordinary
# statements, which hides the control flow this policy is about.
[ControlStructures::ProhibitPostfixControls]

# These CLIs document their interface as NAME, SYNOPSIS, DESCRIPTION,
# OPTIONS and EXIT STATUS (ADR-0002: the interface is the CLI, documented in
# the OPTIONS POD). The policy's default script list is a distribution
# template (AUTHOR, LICENSE AND COPYRIGHT, INCOMPATIBILITIES, …) that would
# be empty boilerplate in a personal dotfiles script, so require the
# sections these scripts already use instead.
[Documentation::RequirePodSections]
script_sections = NAME | SYNOPSIS | DESCRIPTION | OPTIONS | EXIT STATUS
