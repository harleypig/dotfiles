{
  "files": [
    {
      "movable": true,
      "path": "$HOME/.oh-my-bash"
    },
    {
      "env": "HISTFILE",
      "mechanism": "env",
      "movable": true,
      "path": "$HOME/.bash_history",
      "rewrite": "$XDG_STATE_HOME/bash/history"
    }
  ],
  "ignore": [
    {
      "path": "$HOME/.bash_logout",
      "reason": "the dotfiles shell-startup owns bash config"
    },
    {
      "path": "$HOME/.bash_login",
      "reason": "the dotfiles shell-startup owns bash config"
    },
    {
      "path": "$HOME/.bash_profile",
      "reason": "the dotfiles shell-startup owns bash config"
    },
    {
      "path": "$HOME/.bash_aliases",
      "reason": "the dotfiles shell-startup owns bash config"
    },
    {
      "path": "$HOME/.bashrc",
      "reason": "the dotfiles shell-startup owns bash config"
    }
  ],
  "name": "bash",
  "override-of": "bash",
  "upstream-digest": "871e61773e8c19669887cdbb33732170ec7fee007d65b1354942bacf3ad78b4b"
}
