# shellcheck shell=bash

# Environment for perl and perl-related tooling.
#
# Two perl setups are supported, preferred order:
#   1. A vmgr-managed perlbrew under XDG_DATA_HOME (what `vmgr install perl`
#      builds). When present it is activated and owns the perl environment.
#   2. Otherwise the existing system-perl + $HOME local::lib setup is preserved
#      unchanged.
# This is deliberately ADDITIVE: until you run `vmgr install perl`, nothing
# about the current perl changes - the XDG branch is simply skipped. The full
# migration off the $HOME local::lib happens when you install the perlbrew
# toolchain, not before.

havecmd perl || return 0

# cpanm work dir, relocated under XDG (was ~/.cpanm). Harmless when unused.
export PERL_CPANM_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/cpanm"

#-----------------------------------------------------------------------------
# Activate the perl environment: the vmgr-managed perlbrew if installed, else
# the legacy system-perl + local::lib setup.
setup_perlbrew() {
  local pb_xdg="${XDG_DATA_HOME:-$HOME/.local/share}/perlbrew"

  # Preferred: the vmgr-managed perlbrew. Its bashrc prepends the default Perl
  # to PATH and defines the `perlbrew` shell function. Unlike nvm (whose
  # nvm.sh runs a slow `nvm use default`), perlbrew's bashrc is a lightweight
  # PATH/env setup, so it is sourced eagerly - the default Perl is active at
  # login, matching how the pinned Perl is meant to be the working Perl.
  if [[ -s $pb_xdg/etc/bashrc ]]; then
    export PERLBREW_ROOT="$pb_xdg"

    # shellcheck disable=SC1091  # provided by the perlbrew install at runtime
    source "$PERLBREW_ROOT/etc/bashrc"

    return 0
  fi

  # Fallback: the existing system-perl + $HOME (or /opt) local::lib. Preserved
  # verbatim so a machine that has not migrated keeps working.
  havecmd perlbrew && [[ -f $PERLBREW_ROOT/etc/perlbrew-completion.bash ]] \
    && source "$PERLBREW_ROOT/etc/perlbrew-completion.bash"

  if [[ -d $HOME/perl5 ]]; then
    export PERLBREW_HOME=$HOME
  elif [[ -d /opt/perl5 ]]; then
    export PERLBREW_HOME=/opt
  fi

  if [[ -n ${PERLBREW_HOME:-} ]]; then
    export PERL5LIB="$PERLBREW_HOME/lib/perl5:$PERL5LIB"
    export PERLBREW_ROOT="$PERLBREW_HOME/perl5"
    export PERL_LOCAL_LIB_ROOT="$PERLBREW_HOME:$PERL_LOCAL_LIB_ROOT"
    export PERL_MB_OPT="--install_base \"$PERLBREW_HOME\""
    export PERL_MM_OPT="INSTALL_BASE=$PERLBREW_HOME"

    PATH="$PERLBREW_HOME/bin:$PATH"

    [[ -d $PERLBREW_ROOT/bin ]] && PATH="$PATH:$PERLBREW_ROOT/bin"

    export PATH
  fi
}

#-----------------------------------------------------------------------------
setup_dzil() {
  havecmd dzil || return 0

  # Run author or release tests, or a single test
  alias dztestauthor="AUTHOR_TESTING=1 dzil run prove -l"
  alias dztestauthorv="AUTHOR_TESTING=1 dzil run prove -lv"
  alias dztestauthorall="AUTHOR_TESTING=1 dzil run prove -l xt/author/*.t"
  alias dztestrelease="RELEASE_TESTING=1 dzil run prove -l"
  alias dztestreleasev="RELEASE_TESTING=1 dzil run prove -lv"
  alias dztestreleaseall="RELEASE_TESTING=1 dzil run prove -l xt/release/*.t"
  alias dztesttest="dzil run prove -l"
  alias dztesttestv="dzil run prove -lv"

  alias authordeps="dzil authordeps"
  alias listdeps="dzil listdeps"

  perl -MDist::Zilla::App::Command::bakeini -e '' &> /dev/null && alias bakeini="dzil bakeini"
}

#-----------------------------------------------------------------------------
setup_prove() {
  havecmd prove || return 0

  # Run author or release tests, or a single test
  alias testauthor='AUTHOR_TESTING=1 prove -l'
  alias testauthorv='AUTHOR_TESTING=1 prove -lv'
  alias testauthorall='AUTHOR_TESTING=1 prove -l xt/author/*.t'
  alias testrelease='RELEASE_TESTING=1 prove -l'
  alias testreleasev='RELEASE_TESTING=1 prove -lv'
  alias testreleaseall='RELEASE_TESTING=1 prove -l xt/release/*.t'
  alias testtest='prove -l'
  alias testtestv='prove -lv'
}

#-----------------------------------------------------------------------------
# perlbrew/local::lib set PATH / PERL5LIB / PERL* - needed in any shell, so run
# it before the interactive guard.
setup_perlbrew

# setup_perlbrew is a load-time helper; drop it so it does not linger in the
# shell namespace. Unset it before the interactive guard so non-interactive
# shells are cleaned too; the interactive-only setup_dzil/setup_prove are
# unset at the module's end.
unset -f setup_perlbrew

##############################################################################
# Interactive-only below - aliases and helpers.

[[ $- == *i* ]] || return 0

#-----------------------------------------------------------------------------
# https://metacpan.org/module/Catalyst::Manual::Tutorial::07_Debugging#DEBUGGING-MODULES-FROM-CPAN
# shellcheck disable=2154
alias cmver="perl -e'for(@ARGV){\$v=eval\"require \$_\"?(\$_->VERSION||q(unknown)):q(not installed);print\"\$_ \$v\\n\"}'"

# replace perldoc with cpandoc if it's installed
havecmd cpandoc && alias perldoc='cpandoc'

# Alias cpanm -S only if cpanm is installed and it's not installed in the home directory.
havecmd cpanm && {
  [[ $(which cpanm) != $HOME/* ]] && alias cpanm='cpanm -S'
}

setup_dzil
setup_prove

# The setup_* helpers only defined aliases (which persist); the functions
# themselves are load-time scratch, so drop them from the shell namespace.
unset -f setup_dzil setup_prove
