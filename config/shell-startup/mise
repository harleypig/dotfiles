# shellcheck shell=bash

havecmd mise || return 0

# Directory-based tool switching runs via a PROMPT_COMMAND hook, which only
# fires in an interactive shell.
[[ $- == *i* ]] || return 0

if _bash_prompt_supports_hooks; then
  eval "$(mise activate bash)"
  _bash_prompt_reorder_hooks
else
  # Pre-5.1 bash can't compose PROMPT_COMMAND as an array, so mise's prompt
  # hook can't be safely chained behind _capture_exit_status -- fall back to
  # shims-only activation (PATH-based, no directory-based auto-switching).
  eval "$(mise activate bash --shims)"
fi
