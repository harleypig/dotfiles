# shellcheck shell=bash

#-----------------------------------------------------------------------------
# Rust (rustup + cargo) environment. Needed in any shell, so it runs before
# the interactive guard below.
#
# Both homes are XDG data: `vmgr install rust` puts rustup and its proxies
# (rustc, cargo, ...) in $CARGO_HOME/bin and the toolchains under
# $RUSTUP_HOME.

export CARGO_HOME="$XDG_DATA_HOME/cargo"

# RUSTUP_HOME used to be $XDG_CONFIG_HOME/rustup. While toolchains are still
# only there, keep using it, so the move cannot orphan an installed toolchain;
# once the data home has toolchains it wins. Both checks look at toolchains/,
# not the dir: the old dir is tracked in this repo (settings.toml), and any
# rustup call creates the new one with just a settings.toml.
_rust_home="$XDG_DATA_HOME/rustup"

[[ ! -d $_rust_home/toolchains && -d $XDG_CONFIG_HOME/rustup/toolchains ]] \
  && _rust_home="$XDG_CONFIG_HOME/rustup"

export RUSTUP_HOME="$_rust_home"
unset _rust_home

# Prepending after the mise module ran is what puts vmgr's rust ahead of
# mise's when both are installed (ADR-0007). It also puts anything
# `cargo install` put there ahead of the system copies.
[[ -d $CARGO_HOME/bin ]] && export PATH="$CARGO_HOME/bin:$PATH"

#-----------------------------------------------------------------------------
# Rust (rustup + cargo) bash completion.
#
# Both vendored into config/completions/ from the official generators, so no
# rustup/rustc fork is paid at startup:
#   rustup ← `rustup completions bash`
#   cargo  ← the toolchain's etc/bash_completion.d/cargo (what
#            `rustup completions bash cargo` sources)
# Regenerate on toolchain upgrade — see config/completions/README.md.

[[ $- == *i* ]] || return 0

havecmd rustup \
  && [[ -r "$XDG_CONFIG_HOME/completions/rustup" ]] \
  && source "$XDG_CONFIG_HOME/completions/rustup"

havecmd cargo \
  && [[ -r "$XDG_CONFIG_HOME/completions/cargo" ]] \
  && source "$XDG_CONFIG_HOME/completions/cargo"
