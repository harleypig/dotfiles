# shellcheck shell=bash
# Environment variable reference: https://code.claude.com/docs/en/env-vars
#
# NOTE: CLAUDE_CONFIG_DIR is not fully honored by all Claude Code
# components — plugins still hardcode ~/.claude. A symlink is required:
#   ln -s "$CLAUDE_CONFIG_DIR" "$HOME/.claude"

havecmd claude || return 0

export CLAUDE_CODE_NO_FLICKER=1

# Point CLAUDE_CONFIG_DIR at the standalone agent-config repo only when it is
# actually present. If it isn't, leave the variable unset and let Claude Code
# fall back to its ~/.claude default — provisioning that is the user's job,
# not this startup file's concern.
if [[ -d $PROJECTS_DIR/dotagents ]]; then
  export CLAUDE_CONFIG_DIR="$PROJECTS_DIR/dotagents"
fi
