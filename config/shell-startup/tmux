#!/bin/bash

havecmd tmux || return 0

# Aliases — interactive shells only.
[[ $- == *i* ]] || return 0

# swap this window to the left
alias swapl='tmux swap-window -t -1 ; tmux select_window -t -'

# swap this window to the right
alias swapr='tmux swap-window -t +1 ; tmux select_window -t +'

# swap this window with the one passed in
alias swapw='tmux swap-window -t'

# Interactive helpers the user calls; no child needs them, so they are not
# `export -f`ed (that would push them into every child process's env).
# shellcheck disable=SC1003  # literal \e in the printf format, not a quote
set_title() { printf '\ek%s\e\\' "$1"; }
# shellcheck disable=SC1003  # literal \e in the printf format, not a quote
unset_title() { printf '\ek\e\\'; }

tmux_winidx_circled() {
  local winidx
  winidx=$(tmux display-message -p '#I')

  if ((winidx > 20)); then
    echo "($winidx)"

  else
    # The circled-digit table is function-local so it doesn't pollute module
    # scope. This helper isn't wired into the status line (not a hot path), so
    # rebuilding the table per call is fine.
    local circled_digits
    # shellcheck disable=SC1083
    circled_digits=$(printf %s \${$'\xEA',\`,{a..s}} | iconv -f UTF-16BE)

    echo "${circled_digits:winidx:1}"
  fi
}

# Start session in background if it doesn't already exist.
# We want user to be expanded when defined.
# havecmd (command -v) reports an existing ta alias/function too, so an
# already-defined ta is not clobbered.
# TODO: when multiple tmux sessions exist, have `ta` list them and let the
# user choose, instead of always attaching the $USER session. See TODO.md.
if havecmd ta; then
  #echo 'alias ta already exists'
  :

else
  # Not `export -f`ed: ta is an interactive attach helper; a child interactive
  # shell defines its own via startup, so no child needs it in its env.
  ta() {
    tmux has-session -t "$USER" &> /dev/null || tmux new-session -d -s "$USER"
    tmux -2 a -t "$USER"
  }
fi
