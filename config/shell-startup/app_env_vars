# shellcheck shell=bash

# Environment variables for applications without aliases or functions
# (single-setting tools; anything with more lives in its own module).
# node/npm env lives in the node module alongside the rest of its setup.

# Check if ELINKS is installed and set ELINKS_CONFDIR if it is
if havecmd elinks; then
  export ELINKS_CONFDIR="$HOME/.elinks"
fi

# The XDG redirects below are exported unconditionally (the KIVY_HOME /
# GRADLE_USER_HOME pattern): each names a directory its tool reads and is inert
# when the tool is absent, so an unconditional export keeps the redirect in
# effect the moment the tool is installed — and visible to xdg-audit as active,
# so a leftover reads as stray rather than unhandled.

# Redirect GnuPG's home out of ~/.gnupg (keys + config -> data dir).
export GNUPGHOME="${XDG_DATA_HOME}/gnupg"

# Redirect ledger/hledger's journal out of ~/.
export LEDGER_FILE="${XDG_DATA_HOME}/hledger/journal"

# Redirect Gradle's home out of ~/.gradle (build cache + config → data dir).
# Set unconditionally (like KIVY_HOME below): GRADLE_USER_HOME is inert when
# Gradle is absent, and an unconditional export keeps the redirect in effect —
# and visible to xdg-audit as active — regardless of install state.
export GRADLE_USER_HOME="${XDG_DATA_HOME}/gradle"

# Redirect GNU parallel's home out of ~/.parallel. Set unconditionally for the
# same reason as GRADLE_USER_HOME above (inert when parallel is absent).
export PARALLEL_HOME="${XDG_CONFIG_HOME}/parallel"

# Redirect SQLite's REPL history out of ~/.sqlite_history (sqlite reads its
# config from $XDG_CONFIG_HOME/sqlite3/sqliterc on its own since 3.44). Set
# unconditionally, as with the redirects above.
export SQLITE_HISTORY="${XDG_STATE_HOME}/sqlite_history"

# Redirect Kivy's home out of ~/.kivy. Set unconditionally: Kivy is a Python
# library with no CLI to detect via havecmd, and the variable is inert when
# Kivy is absent.
export KIVY_HOME="${XDG_DATA_HOME}/kivy"
